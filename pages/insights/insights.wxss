.page { min-height: 100vh; display: flex; flex-direction: column; background: #f4f5fb; }
.topbar { padding: 30rpx 32rpx 18rpx; flex-shrink: 0; }
.tb-title { display: block; color: #17152b; font-size: 34rpx; font-weight: 800; }
.tb-sub { display: block; margin-top: 6rpx; color: #9a94b8; font-size: 20rpx; }

.tabs { display: flex; flex-shrink: 0; margin: 0 32rpx 18rpx; padding: 6rpx; border-radius: 999rpx; background: #e9e7f4; }
.tab { flex: 1; padding: 14rpx 0; border-radius: 999rpx; color: #837da0; font-size: 21rpx; font-weight: 600; text-align: center; }
.tab.active { background: #fff; color: #6f5ce8; box-shadow: 0 3rpx 10rpx rgba(26,22,51,.08); }

.state { flex: 1; display: flex; align-items: center; justify-content: center; flex-direction: column; padding: 80rpx 40rpx; }
.spinner { width: 44rpx; height: 44rpx; margin-bottom: 20rpx; border: 4rpx solid #e5e1f5; border-top-color: #7c6cf0; border-radius: 50%; animation: spin .8s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }
.state-title { color: #837da0; font-size: 22rpx; }
.state-btn { margin-top: 22rpx; padding: 14rpx 34rpx; border-radius: 999rpx; background: #7c6cf0; color: #fff; font-size: 21rpx; }

.body { flex: 1; min-height: 0; }
.pane { padding: 0 32rpx 60rpx; }
.warn-bar { margin-bottom: 18rpx; padding: 16rpx 20rpx; border-radius: 14rpx; background: #fff5e6; color: #a5762c; font-size: 19rpx; line-height: 1.5; }

/* 年报 */
.year-nav { display: flex; align-items: center; justify-content: space-between; margin-bottom: 18rpx; }
.yn-btn { width: 130rpx; color: #7c6cf0; font-size: 21rpx; font-weight: 600; }
.yn-btn:last-child { text-align: right; }
.yn-mid { display: flex; flex-direction: column; align-items: center; }
.yn-year { color: #17152b; font-size: 38rpx; font-weight: 800; }
.yn-label { margin-top: 2rpx; color: #a09ab8; font-size: 18rpx; }

.slides { height: 620rpx; }
.slide { height: 580rpx; margin: 0 8rpx; padding: 44rpx 40rpx; display: flex; flex-direction: column; border-radius: 28rpx; overflow: hidden; }
.slide.cover { background: linear-gradient(135deg, #1a1633, #3a2f7a); }
.slide.travel { background: linear-gradient(135deg, #123c4a, #1f7a72); }
.slide.quest { background: linear-gradient(135deg, #2b1f4d, #6b46c1); }
.slide.people { background: linear-gradient(135deg, #4a1f3a, #a34d78); }
.slide.music { background: linear-gradient(135deg, #1f2a4a, #4a5fc1); }
.slide.books { background: linear-gradient(135deg, #123a34, #2f8f7a); }
.slide.rhythm { background: linear-gradient(135deg, #3a2a12, #a97a2c); }
.slide.end { background: linear-gradient(135deg, #1a1633, #2f2a55); }
.sl-kicker { color: rgba(255,255,255,.6); font-size: 19rpx; letter-spacing: .16em; }
.sl-title { margin-top: 26rpx; color: #fff; font-size: 44rpx; font-weight: 800; line-height: 1.3; white-space: pre-line; }
.sl-body { margin-top: 20rpx; color: rgba(255,255,255,.86); font-size: 23rpx; line-height: 1.7; }
.sl-metric { display: flex; align-items: baseline; gap: 14rpx; margin-top: auto; }
.sl-metric-num { color: #fff; font-size: 64rpx; font-weight: 800; }
.sl-metric-label { color: rgba(255,255,255,.72); font-size: 20rpx; }
.sl-foot { margin-top: 12rpx; color: rgba(255,255,255,.5); font-size: 18rpx; }

.dots { display: flex; justify-content: center; gap: 8rpx; margin: 18rpx 0 24rpx; }
.dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: #dcd8ee; }
.dot.on { width: 28rpx; border-radius: 999rpx; background: #7c6cf0; }

.verdict { padding: 22rpx 26rpx; border-radius: 18rpx; background: #fff; border: 2rpx solid #f0eef8; }
.vd-label { display: block; color: #a09ab8; font-size: 18rpx; }
.vd-text { display: block; margin-top: 8rpx; color: #3a3552; font-size: 23rpx; line-height: 1.6; }

.acts { display: flex; gap: 14rpx; margin-top: 22rpx; }
.act { flex: 1; padding: 20rpx 0; border-radius: 16rpx; background: #fff; border: 2rpx solid #e9e6f6; color: #6f5ce8; font-size: 21rpx; font-weight: 600; text-align: center; }
.act.primary { background: #7c6cf0; border-color: #7c6cf0; color: #fff; }
.pane-note { display: block; margin-top: 20rpx; color: #a09ab8; font-size: 18rpx; line-height: 1.6; }

/* 通用卡与列表 */
.hero-card { padding: 34rpx 30rpx; border-radius: 24rpx; }
.hero-card.music { background: linear-gradient(135deg, #1f2a4a, #4a5fc1); }
.hero-card.balance { background: linear-gradient(135deg, #1a1633, #3a2f7a); }
.hero-card.archive { background: linear-gradient(135deg, #123c4a, #2f8f80); }
.hc-kicker { color: rgba(255,255,255,.6); font-size: 18rpx; letter-spacing: .16em; }
.hc-title { display: block; margin-top: 14rpx; color: #fff; font-size: 34rpx; font-weight: 800; }
.hc-body { display: block; margin-top: 14rpx; color: rgba(255,255,255,.84); font-size: 21rpx; line-height: 1.7; }

.sec-title { display: block; margin: 34rpx 0 14rpx; padding-left: 14rpx; border-left: 6rpx solid #7c6cf0; color: #17152b; font-size: 24rpx; font-weight: 700; }
.list { border-radius: 18rpx; background: #fff; overflow: hidden; }
.li { display: flex; align-items: center; padding: 20rpx 22rpx; border-bottom: 2rpx solid #f3f1fa; }
.li:last-child { border-bottom: none; }
.li-year, .li-flag { width: 92rpx; flex-shrink: 0; color: #7c6cf0; font-size: 24rpx; font-weight: 700; }
.li-flag { width: 56rpx; }
.li-main { flex: 1; min-width: 0; }
.li-name { display: block; color: #17152b; font-size: 22rpx; font-weight: 600; }
.li-sub { display: block; margin-top: 4rpx; color: #a09ab8; font-size: 18rpx; }
.empty { padding: 28rpx; border-radius: 18rpx; background: #fff; color: #a09ab8; font-size: 20rpx; text-align: center; }

.timeline { padding-left: 8rpx; }
.tl-item { position: relative; padding: 0 0 26rpx 30rpx; border-left: 2rpx solid #e2def4; }
.tl-dot { position: absolute; left: -9rpx; top: 8rpx; width: 16rpx; height: 16rpx; border-radius: 50%; background: #7c6cf0; }
.tl-day { display: block; color: #a09ab8; font-size: 18rpx; }
.tl-title { display: block; margin-top: 4rpx; color: #17152b; font-size: 22rpx; font-weight: 600; }
.tl-song { display: block; margin-top: 4rpx; color: #6f5ce8; font-size: 19rpx; }
.tl-song.dim { color: #c4bfd8; }

/* 负债表 */
.chart { display: flex; align-items: flex-end; height: 240rpx; padding: 16rpx 12rpx 0; border-radius: 18rpx; background: #fff; }
.bar-col { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; height: 100%; }
.bar { width: 56%; max-width: 44rpx; border-radius: 8rpx 8rpx 0 0; background: linear-gradient(#9b8cf5, #7c6cf0); }
.bar-val { margin-bottom: 6rpx; color: #837da0; font-size: 16rpx; }
.bar-year { margin-top: 8rpx; margin-bottom: 10rpx; color: #a09ab8; font-size: 16rpx; }

.accounts { display: flex; flex-direction: column; gap: 12rpx; }
.acc { padding: 22rpx 24rpx; border-radius: 18rpx; background: #fff; border: 2rpx solid #f0eef8; }
.acc.none { background: #faf9fe; border-style: dashed; }
.acc-head { display: flex; align-items: center; gap: 12rpx; }
.acc-icon { color: #7c6cf0; font-size: 26rpx; }
.acc-name { color: #17152b; font-size: 23rpx; font-weight: 700; }
.acc-badge { padding: 3rpx 12rpx; border-radius: 999rpx; font-size: 16rpx; }
.acc-badge.measured { background: #eaf7f3; color: #1f8f79; }
.acc-badge.proxy { background: #fff4e4; color: #b8862c; }
.acc-badge.none { background: #f0eef8; color: #9a94b8; }
.acc-val { margin-left: auto; color: #17152b; font-size: 32rpx; font-weight: 800; }
.acc-track { height: 10rpx; margin-top: 14rpx; border-radius: 999rpx; background: #f0eef8; overflow: hidden; }
.acc-fill { height: 100%; border-radius: 999rpx; background: linear-gradient(90deg, #9b8cf5, #7c6cf0); }
.acc-desc { display: block; margin-top: 12rpx; color: #837da0; font-size: 18rpx; line-height: 1.5; }
.acc-trend { display: block; margin-top: 6rpx; color: #a09ab8; font-size: 17rpx; }

.judgments { padding: 20rpx 24rpx; border-radius: 18rpx; background: #fff; }
.jd { display: flex; gap: 10rpx; margin-bottom: 12rpx; }
.jd:last-child { margin-bottom: 0; }
.jd-dot { color: #7c6cf0; font-size: 24rpx; }
.jd-text { flex: 1; color: #3a3552; font-size: 21rpx; line-height: 1.6; }
.caveats { margin-top: 20rpx; padding: 22rpx 24rpx; border-radius: 18rpx; background: #fff8ee; border: 2rpx solid #f2e2c4; }
.cv-head { display: block; margin-bottom: 10rpx; color: #a5762c; font-size: 20rpx; font-weight: 700; }
.cv-line { display: block; margin-bottom: 8rpx; color: #8a6d3b; font-size: 18rpx; line-height: 1.6; }

/* 存档 */
.counts { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 20rpx; }
.ct { width: 31%; padding: 20rpx 0; border-radius: 16rpx; background: #fff; text-align: center; }
.ct-num { display: block; color: #17152b; font-size: 32rpx; font-weight: 800; }
.ct-label { display: block; margin-top: 4rpx; color: #a09ab8; font-size: 17rpx; }
.exp-card { padding: 24rpx; border-radius: 18rpx; background: #fff; border: 2rpx solid #f0eef8; }
.exp-desc { display: block; color: #837da0; font-size: 20rpx; line-height: 1.7; }
.exp-acts { display: flex; gap: 14rpx; margin-top: 20rpx; }
.saved-path { display: block; margin-top: 20rpx; color: #a09ab8; font-size: 17rpx; word-break: break-all; }
