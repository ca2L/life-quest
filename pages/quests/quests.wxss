/* 任务看板 · 紧凑一体化版式
   思路：内容区收窄 → 分组做成「一张连续白卡 + 细分隔线」，不再是一堆浮起来的独立卡片；
   筛选改成分段控件，仪表盘缩小，整体减少割裂感。 */
.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 28rpx 24rpx 64rpx;
  background: #f6f6fa;
}
/* 收窄主内容，避免所有信息都撑满整屏 */
.content { max-width: 640rpx; margin: 0 auto; }

.state-card { display: flex; min-height: 70vh; align-items: center; flex-direction: column; justify-content: center; }
.spinner {
  width: 56rpx; height: 56rpx;
  border: 6rpx solid #e4e1f5; border-top-color: #6f5ce8;
  border-radius: 50%; animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
.state-title { margin-top: 24rpx; color: #6b6585; font-size: 28rpx; }
.login-wrap { justify-content: flex-start; padding-top: 90rpx; }
.login-hero { display: flex; align-items: flex-start; flex-direction: column; margin-bottom: 56rpx; }
.login-eyebrow { color: #6f5ce8; font-size: 22rpx; font-weight: 600; letter-spacing: 6rpx; }
.login-title { margin-top: 20rpx; color: #17152b; font-size: 58rpx; font-weight: 700; line-height: 1.28; letter-spacing: -1rpx; white-space: pre-line; }
.login-desc { margin-top: 20rpx; color: #8a85a5; font-size: 26rpx; line-height: 1.6; }

.head { display: flex; align-items: center; justify-content: space-between; }
.head-eyebrow { display: block; color: #9a94b8; font-size: 17rpx; font-weight: 600; letter-spacing: 3rpx; }
.head-title { display: block; margin-top: 4rpx; color: #17152b; font-size: 36rpx; font-weight: 700; letter-spacing: -1rpx; }
.head-sub { display: block; margin-top: 6rpx; color: #8a85a5; font-size: 22rpx; }
.head-actions { display: flex; gap: 10rpx; }
.tpl-btn, .add-btn { padding: 14rpx 20rpx; border-radius: 16rpx; font-size: 22rpx; font-weight: 600; transition: transform 0.15s ease; }
.tpl-btn:active, .add-btn:active { transform: scale(0.94); }
.tpl-btn { background: #ffffff; color: #5a49c4; }
.add-btn { background: #6f5ce8; color: #ffffff; }

/* 数据仪表：缩小、去重大阴影，和下方白卡保持同一视觉重量 */
.dashboard {
  display: flex;
  margin-top: 22rpx;
  padding: 22rpx 24rpx;
  align-items: center;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #2a2158 0%, #1b1538 60%, #141029 100%);
  box-shadow: 0 6rpx 18rpx rgba(26, 22, 51, 0.16);
}
.dash-ring { position: relative; width: 140rpx; height: 140rpx; flex-shrink: 0; border-radius: 50%; }
.dash-ring-fill { position: absolute; inset: 0; border-radius: 50%; border: 3rpx solid rgba(167, 140, 250, 0.35); }
.dash-ring-core {
  position: absolute; inset: 12rpx;
  display: flex; align-items: center; justify-content: center; flex-direction: column;
  border-radius: 50%; background: rgba(23, 18, 41, 0.9);
}
.dash-ring-num { color: #ffffff; font-size: 34rpx; font-weight: 800; text-shadow: 0 0 16rpx rgba(143, 123, 245, 0.8); }
.dash-ring-pct { font-size: 20rpx; font-weight: 600; }
.dash-ring-label { margin-top: 2rpx; color: #a99cf2; font-size: 17rpx; }
.dash-grid { display: flex; margin-left: 22rpx; flex: 1; flex-wrap: wrap; }
.dash-item { display: flex; width: 50%; box-sizing: border-box; padding: 6rpx 0 6rpx 4rpx; align-items: flex-start; flex-direction: column; }
.dash-num { color: #ffffff; font-size: 30rpx; font-weight: 800; }
.dash-label { margin-top: 2rpx; color: #9c92c9; font-size: 18rpx; }

.section-head { display: flex; margin: 24rpx 4rpx 12rpx; align-items: center; justify-content: space-between; }
.section-title { color: #17152b; font-size: 27rpx; font-weight: 600; }
.section-tip { color: #a09ab8; font-size: 20rpx; }

/* 章节进度：去掉每张卡的浮起阴影，改成一排贴在一起的浅色格 */
.chapter-scroll { width: 100%; white-space: nowrap; }
.chapter-row { display: inline-flex; gap: 10rpx; padding-bottom: 6rpx; }
.chapter-chip {
  display: flex;
  width: 176rpx;
  padding: 16rpx;
  box-sizing: border-box;
  flex-direction: column;
  border-radius: 18rpx;
  background: #ffffff;
  border: 2rpx solid #eeecf6;
  transition: transform 0.15s ease;
}
.chapter-chip:active { transform: scale(0.96); }
.chapter-chip.idle { opacity: 0.55; }
.chapter-chip.cleared { background: linear-gradient(135deg, #fff9ec, #fff3d6); border-color: #ffe3a8; }
.chapter-top { display: flex; width: 100%; align-items: center; justify-content: space-between; }
.chapter-idx { color: #b5aef0; font-size: 19rpx; font-weight: 700; }
.chapter-clear { padding: 2rpx 10rpx; border-radius: 10rpx; background: #ffd166; color: #7a5200; font-size: 16rpx; font-weight: 700; }
.chapter-name { margin-top: 6rpx; overflow: hidden; color: #17152b; font-size: 22rpx; font-weight: 600; text-overflow: ellipsis; }
.chapter-count { margin-top: 6rpx; color: #8a85a5; font-size: 18rpx; }
.chapter-bar { height: 6rpx; margin-top: 10rpx; overflow: hidden; border-radius: 6rpx; background: #eeecf8; }
.chapter-fill { height: 100%; border-radius: 6rpx; background: #6f5ce8; }
.chapter-fill.gold { background: linear-gradient(90deg, #ffd166, #ff9f43); }

/* 筛选：一个连续的分段控件，不再是 4 个散落的胶囊 */
.filter-bar {
  display: flex; margin: 22rpx 0 18rpx; padding: 6rpx;
  border-radius: 18rpx; background: #e9e7f3;
}
.filter-item { flex: 1; padding: 14rpx 0; border-radius: 14rpx; color: #6b6585; font-size: 23rpx; text-align: center; }
.filter-item.active { background: #ffffff; color: #5a49c4; font-weight: 700; box-shadow: 0 2rpx 10rpx rgba(26, 22, 51, 0.1); }
.error-bar { margin-bottom: 16rpx; padding: 18rpx 22rpx; border-radius: 16rpx; background: #ffe9e9; color: #c0392b; font-size: 23rpx; }

/* 分组 = 一张连续白卡；任务之间只用细线分隔，不再各自浮起 */
.group {
  margin-bottom: 20rpx;
  overflow: hidden;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(26, 22, 51, 0.04);
}
.group-head {
  display: flex;
  margin: 0;
  padding: 20rpx 24rpx;
  align-items: center;
  border-bottom: 2rpx solid #f2f0f8;
}
.group-icon {
  display: flex; width: 44rpx; height: 44rpx;
  align-items: center; justify-content: center;
  border-radius: 12rpx; background: #6f5ce8; color: #fff;
  font-size: 20rpx; font-weight: 700;
}
.group-meta { display: flex; margin-left: 14rpx; flex: 1; min-width: 0; flex-direction: column; }
.group-name { color: #2a2252; font-size: 25rpx; font-weight: 600; }
.group-sub { margin-top: 3rpx; color: #8a85a5; font-size: 19rpx; }
.group-count { color: #6b5bc4; font-size: 21rpx; }
.group-arrow { margin-left: 12rpx; color: #8a85a5; font-size: 26rpx; }

.quest-list { display: flex; flex-direction: column; padding: 0 24rpx; }
.quest-card {
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f5f4fa;
  animation: rise-in 0.4s cubic-bezier(0.22, 1, 0.36, 1) both;
}
.quest-card:last-child { border-bottom: none; }
.quest-card.done { opacity: 0.62; }
@keyframes rise-in { from { opacity: 0; transform: translateY(14rpx); } to { opacity: 1; transform: translateY(0); } }
.card-head { display: flex; align-items: center; }
.type-tag { padding: 5rpx 14rpx; border-radius: 10rpx; font-size: 19rpx; font-weight: 600; }
.type-main { background: #e8e4ff; color: #5a49c4; }
.type-side { background: #e0f5ee; color: #1d9e75; }
.due { margin-left: 12rpx; color: #b08a3c; font-size: 19rpx; }
.reward { margin-left: auto; padding: 5rpx 14rpx; border-radius: 10rpx; background: #fff6e2; color: #c78a12; font-size: 19rpx; font-weight: 700; }
.quest-title { display: block; margin-top: 12rpx; color: #17152b; font-size: 27rpx; font-weight: 600; line-height: 1.4; }
.quest-desc { display: block; margin-top: 6rpx; color: #8a85a5; font-size: 22rpx; line-height: 1.5; }
.progress-row { display: flex; margin-top: 14rpx; align-items: center; }
.progress-bar { flex: 1; height: 10rpx; overflow: hidden; border-radius: 8rpx; background: #eeecf8; }
.progress-fill { height: 100%; border-radius: 8rpx; background: #6f5ce8; }
.progress-text { margin-left: 14rpx; color: #6f5ce8; font-size: 21rpx; font-weight: 600; }
.card-foot { display: flex; margin-top: 14rpx; align-items: center; justify-content: space-between; }
.card-actions { display: flex; gap: 20rpx; }
.action { color: #6f5ce8; font-size: 21rpx; }
.action-del { color: #e05a5a; }
.checkin-btn { padding: 10rpx 24rpx; border-radius: 14rpx; background: linear-gradient(135deg, #6f5ce8, #8f7bf5); color: #ffffff; font-size: 22rpx; font-weight: 600; box-shadow: 0 6rpx 16rpx rgba(111, 92, 232, 0.24); }
.done-actions { display: flex; align-items: center; gap: 16rpx; }
.done-tag { padding: 5rpx 14rpx; border-radius: 10rpx; background: #e0f5ee; color: #1d9e75; font-size: 20rpx; font-weight: 700; }
.reset-link { color: #a09ab8; font-size: 21rpx; }

.empty { display: flex; padding: 64rpx 24rpx; align-items: center; flex-direction: column; }
.empty-icon { color: #9b8ff0; font-size: 68rpx; }
.empty-text { margin-top: 16rpx; color: #4a37b0; font-size: 29rpx; font-weight: 600; }
.empty-sub { margin-top: 10rpx; color: #8a85a5; font-size: 23rpx; }
.empty-btns { display: flex; margin-top: 28rpx; gap: 16rpx; }
.empty-btn { padding: 16rpx 30rpx; border-radius: 18rpx; background: #ffffff; color: #5a49c4; font-size: 25rpx; }
.empty-btn.primary { background: #6f5ce8; color: #ffffff; }

.modal-mask { position: fixed; inset: 0; z-index: 100; display: flex; align-items: center; justify-content: center; background: rgba(26, 22, 51, 0.5); }
.modal { box-sizing: border-box; width: 88%; max-height: 88vh; padding: 36rpx; overflow-y: auto; border-radius: 28rpx; background: #ffffff; }
.modal-title { display: block; color: #17152b; font-size: 34rpx; font-weight: 700; }
.modal-sub { display: block; margin-top: 10rpx; color: #8a85a5; font-size: 24rpx; }
.field-label { display: block; margin: 24rpx 0 12rpx; color: #6b6585; font-size: 24rpx; }
.type-select { display: flex; gap: 16rpx; }
.type-opt { flex: 1; padding: 18rpx; border: 2rpx solid #e4e1f5; border-radius: 16rpx; color: #6b6585; font-size: 26rpx; text-align: center; }
.type-opt.active { border-color: #6f5ce8; background: #f0edff; color: #5a49c4; font-weight: 600; }
.field-input { box-sizing: border-box; width: 100%; height: 76rpx; padding: 0 22rpx; border-radius: 16rpx; background: #f6f6fa; color: #17152b; font-size: 26rpx; }
.chapter-chips { display: flex; flex-wrap: wrap; gap: 12rpx; }
.chip { padding: 12rpx 18rpx; border-radius: 14rpx; background: #f6f6fa; color: #6b6585; font-size: 22rpx; }
.chip.active { background: #e8e4ff; color: #5a49c4; font-weight: 600; }
.field-row { display: flex; gap: 20rpx; }
.field-col { flex: 1; }
.field-error { display: block; margin-top: 20rpx; color: #e05a5a; font-size: 24rpx; }
.modal-actions { display: flex; margin-top: 36rpx; gap: 20rpx; }
.btn-cancel, .btn-save { flex: 1; padding: 22rpx; border-radius: 18rpx; font-size: 28rpx; text-align: center; }
.btn-cancel { background: #f6f6fa; color: #6b6585; }
.btn-save { background: #6f5ce8; color: #ffffff; font-weight: 600; }

.tpl-item { display: flex; margin-top: 20rpx; padding: 22rpx; align-items: center; border-radius: 18rpx; background: #f7f6fd; }
.tpl-info { display: flex; flex: 1; flex-direction: column; }
.tpl-title { color: #17152b; font-size: 26rpx; font-weight: 600; }
.tpl-desc { margin-top: 8rpx; color: #8a85a5; font-size: 20rpx; }
.tpl-xp { color: #e09b1c; font-size: 24rpx; font-weight: 600; }
