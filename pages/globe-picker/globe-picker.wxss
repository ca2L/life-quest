.page { position: fixed; inset: 0; box-sizing: border-box; display: flex; flex-direction: column; background: #f6f6fa; padding: 20rpx 24rpx 24rpx; }

.gp-head { flex-shrink: 0; }
.gp-head-top { display: flex; align-items: center; justify-content: space-between; }
.gp-title { color: #17152b; font-size: 34rpx; font-weight: 700; }
.gp-chip-count { padding: 6rpx 16rpx; border-radius: 999rpx; background: #ece8ff; color: #5a49c4; font-size: 20rpx; font-weight: 600; }
.gp-sub { display: block; margin-top: 10rpx; color: #8a85a5; font-size: 21rpx; line-height: 1.5; }

.gp-map-wrap { position: relative; flex-shrink: 0; height: 380rpx; margin-top: 20rpx; overflow: hidden; border-radius: 24rpx; }
.gp-map { width: 100%; height: 100%; }
.gp-map-tip { position: absolute; left: 16rpx; bottom: 16rpx; padding: 8rpx 16rpx; border-radius: 999rpx; background: rgba(26, 22, 51, 0.75); color: #fff; font-size: 19rpx; }
.gp-map-fallback { flex-shrink: 0; margin-top: 20rpx; padding: 36rpx 24rpx; border-radius: 24rpx; background: #ece8ff; color: #5a49c4; font-size: 22rpx; line-height: 1.6; text-align: center; }

.gp-coord { display: flex; flex-shrink: 0; margin-top: 18rpx; padding: 18rpx 20rpx; align-items: center; justify-content: space-between; border-radius: 18rpx; background: #fff; }
.gp-coord-text { display: flex; flex: 1; flex-direction: column; min-width: 0; }
.gp-coord-label { color: #9a94b8; font-size: 18rpx; }
.gp-coord-value { margin-top: 4rpx; color: #4a37b0; font-size: 26rpx; font-weight: 700; }
.gp-coord-country { margin-top: 4rpx; color: #8a85a5; font-size: 19rpx; }
.gp-center-btn { flex-shrink: 0; margin-left: 16rpx; padding: 14rpx 18rpx; border-radius: 14rpx; background: #f2f0fb; color: #5a49c4; font-size: 20rpx; }

.gp-search { flex-shrink: 0; margin-top: 16rpx; }
.gp-search-input { height: 68rpx; padding: 0 22rpx; border-radius: 16rpx; background: #fff; color: #17152b; font-size: 24rpx; }

.gp-list { flex: 1; min-height: 0; margin-top: 16rpx; }
.gp-group { margin-bottom: 18rpx; }
.gp-group-name { display: block; margin: 0 4rpx 12rpx; color: #6b6585; font-size: 22rpx; font-weight: 600; }
.gp-group-count { color: #a09ab8; font-size: 19rpx; font-weight: 400; }
.gp-chips { display: flex; flex-wrap: wrap; }
.gp-city { display: flex; margin: 0 12rpx 12rpx 0; padding: 12rpx 18rpx; flex-direction: column; border-radius: 16rpx; background: #fff; border: 2rpx solid transparent; }
.gp-city.picked { border-color: #7c6cf0; background: #f2f0ff; }
.gp-city-name { color: #17152b; font-size: 23rpx; font-weight: 600; }
.gp-city-country { margin-top: 2rpx; color: #a09ab8; font-size: 18rpx; }
.gp-empty { padding: 30rpx; color: #a09ab8; font-size: 22rpx; text-align: center; }
.gp-note { display: block; margin: 10rpx 4rpx 20rpx; color: #b0aac4; font-size: 18rpx; line-height: 1.6; }

.gp-form { flex-shrink: 0; padding-top: 16rpx; border-top: 2rpx solid #e9e6f4; background: #f6f6fa; }
.gp-form-row { display: flex; align-items: center; }
.gp-form-row:nth-child(2) { margin-top: 12rpx; }
.gp-form-label { width: 140rpx; flex-shrink: 0; color: #6b6585; font-size: 22rpx; }
.gp-name-input { flex: 1; height: 68rpx; padding: 0 20rpx; border-radius: 16rpx; background: #fff; color: #17152b; font-size: 24rpx; }
.gp-foot { display: flex; margin-top: 16rpx; }
.gp-confirm { flex: 1; padding: 22rpx 0; border-radius: 18rpx; background: linear-gradient(135deg, #241d52 0%, #6f5ce8 100%); color: #fff; font-size: 26rpx; font-weight: 700; text-align: center; }
.gp-cancel { margin-left: 16rpx; padding: 22rpx 34rpx; border-radius: 18rpx; background: #e9e6f4; color: #6b6585; font-size: 26rpx; text-align: center; }
