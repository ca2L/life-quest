.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 44rpx 28rpx 80rpx;
  background: #f6f6fa;
}

.state-card { display: flex; min-height: 70vh; align-items: center; flex-direction: column; justify-content: center; }
.spinner {
  width: 56rpx; height: 56rpx;
  border: 6rpx solid #e4e1f5; border-top-color: #6f5ce8;
  border-radius: 50%; animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
.state-title { margin-top: 24rpx; color: #8a85a5; font-size: 28rpx; }
.login-wrap { justify-content: flex-start; padding-top: 90rpx; }
.login-hero { display: flex; align-items: flex-start; flex-direction: column; margin-bottom: 56rpx; }
.login-eyebrow { color: #6f5ce8; font-size: 22rpx; font-weight: 600; letter-spacing: 6rpx; }
.login-title {
  margin-top: 20rpx; color: #17152b; font-size: 58rpx; font-weight: 700;
  line-height: 1.28; letter-spacing: -1rpx; white-space: pre-line;
}
.login-desc { margin-top: 20rpx; color: #8a85a5; font-size: 26rpx; line-height: 1.6; }

.greeting { display: flex; margin: 0 4rpx 28rpx; align-items: flex-start; justify-content: space-between; }
.greeting-text { display: flex; flex-direction: column; }
.greeting-eyebrow { color: #9a94b8; font-size: 19rpx; font-weight: 600; letter-spacing: 2rpx; }
.greeting-hello { margin-top: 10rpx; color: #17152b; font-size: 40rpx; font-weight: 700; letter-spacing: -1rpx; }
.greeting-sub { margin-top: 6rpx; color: #8a85a5; font-size: 23rpx; }
.greeting-streak {
  display: flex; margin-top: 6rpx; padding: 12rpx 20rpx;
  align-items: baseline; border-radius: 18rpx; background: #fff2e2;
  animation: pop-in 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) both;
}
.streak-num { color: #e07b1c; font-size: 34rpx; font-weight: 700; }
.streak-unit { margin-left: 6rpx; color: #b26b28; font-size: 20rpx; }

/* 玩家卡 · 左右紧凑版：称号 / XP / 进度条收进一行，高度约为原来一半 */
.player-card {
  position: relative; overflow: hidden;
  padding: 22rpx 24rpx; border-radius: 24rpx;
  background: linear-gradient(135deg, #241d52 0%, #4a37b0 100%);
  box-shadow: 0 12rpx 28rpx rgba(52, 38, 140, 0.26);
  animation: rise-in 0.6s cubic-bezier(0.22, 1, 0.36, 1) both;
}
.player-glow {
  position: absolute; top: -120rpx; right: -80rpx;
  width: 320rpx; height: 320rpx; border-radius: 50%;
  background: radial-gradient(circle, rgba(150, 130, 255, 0.35) 0%, rgba(150, 130, 255, 0) 70%);
}
.player-top { position: relative; display: flex; align-items: center; }
.avatar-wrap { position: relative; width: 76rpx; height: 76rpx; flex-shrink: 0; }
.avatar-ring {
  position: absolute; inset: 0; border-radius: 50%;
  border: 3rpx solid rgba(255, 209, 102, 0.55);
  border-top-color: transparent; transform: rotate(-35deg);
}
.avatar {
  position: absolute; inset: 6rpx;
  display: flex; align-items: center; justify-content: center;
  border-radius: 50%; background: rgba(255, 255, 255, 0.14);
  color: #fff; font-size: 34rpx; font-weight: 700;
}
.player-meta { display: flex; margin-left: 18rpx; flex: 1; min-width: 0; flex-direction: column; }
.player-eyebrow { color: #b9aef7; font-size: 17rpx; font-weight: 600; letter-spacing: 2rpx; }
.player-title { margin-top: 2rpx; color: #fff; font-size: 28rpx; font-weight: 700; }
.player-level { margin-top: 4rpx; overflow: hidden; color: #c9c2ef; font-size: 18rpx; white-space: nowrap; text-overflow: ellipsis; }
.player-badge {
  display: flex; flex-shrink: 0; padding: 10rpx 14rpx; align-items: center; flex-direction: column;
  border-radius: 14rpx; background: rgba(255, 255, 255, 0.14);
}
.pb-num { color: #ffd166; font-size: 26rpx; font-weight: 700; }
.pb-total { color: #d8d2f5; font-size: 16rpx; }
.pb-pct { margin-top: 4rpx; color: #ffd166; font-size: 18rpx; font-weight: 700; }
.xp-bar {
  position: relative; height: 10rpx; margin-top: 12rpx;
  overflow: hidden; border-radius: 8rpx; background: rgba(255, 255, 255, 0.16);
}
.xp-fill {
  height: 100%; border-radius: 8rpx;
  background: linear-gradient(90deg, #ffb84d, #ffd166);
  transition: width 0.6s cubic-bezier(0.22, 1, 0.36, 1);
}

.error-bar { margin-top: 20rpx; padding: 20rpx 24rpx; border-radius: 16rpx; background: #ffe9e9; color: #c0392b; font-size: 24rpx; }

/* 关系熵提醒：低饱和、无催促文案，一眼可关 */
.entropy-bar { display: flex; align-items: center; gap: 14rpx; margin-top: 16rpx; padding: 18rpx 22rpx; border-radius: 18rpx; background: #fdf6f0; border: 2rpx solid #f4e6da; }
.eb-icon { flex-shrink: 0; color: #c98b6b; font-size: 26rpx; }
.eb-text { flex: 1; min-width: 0; color: #7d6555; font-size: 21rpx; line-height: 1.5; }
.eb-close { flex-shrink: 0; color: #b9a796; font-size: 18rpx; }

/* 人生作品入口 */
.works-entry { display: flex; align-items: center; margin-top: 18rpx; padding: 24rpx 26rpx; border-radius: 20rpx; background: linear-gradient(120deg, #2a2350, #4b3c91); }
.we-left { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.we-kicker { color: rgba(255,255,255,.6); font-size: 17rpx; letter-spacing: .14em; }
.we-title { margin-top: 8rpx; color: #fff; font-size: 25rpx; font-weight: 700; }
.we-sub { margin-top: 6rpx; color: rgba(255,255,255,.72); font-size: 18rpx; }
.we-arrow { flex-shrink: 0; margin-left: 16rpx; color: #fff; font-size: 34rpx; }

.dashboard {
  display: flex; margin-top: 24rpx; padding: 30rpx 12rpx;
  align-items: center; border-radius: 24rpx; background: #fff;
  box-shadow: 0 6rpx 20rpx rgba(26, 22, 51, 0.04);
  animation: rise-in 0.6s cubic-bezier(0.22, 1, 0.36, 1) 0.08s both;
}
.dash-item { display: flex; flex: 1; align-items: center; flex-direction: column; }
.dash-num { color: #4a37b0; font-size: 40rpx; font-weight: 700; line-height: 1.1; }
.dash-label { margin-top: 8rpx; color: #a09ab8; font-size: 19rpx; }
.dash-divider { width: 1rpx; height: 48rpx; background: #f0eef8; }

.section-head { display: flex; margin: 44rpx 4rpx 20rpx; align-items: flex-end; justify-content: space-between; }
.section-title-wrap { display: flex; flex-direction: column; }
.section-eyebrow { color: #9a94b8; font-size: 18rpx; font-weight: 600; letter-spacing: 3rpx; }
.section-title { margin-top: 4rpx; color: #17152b; font-size: 34rpx; font-weight: 700; letter-spacing: -0.5rpx; }
.section-badge { padding: 8rpx 20rpx; border-radius: 20rpx; background: #ece8ff; color: #5a49c4; font-size: 24rpx; font-weight: 700; }
.section-link { color: #6f5ce8; font-size: 23rpx; font-weight: 500; }

.grid-card {
  padding: 28rpx 24rpx; border-radius: 24rpx; background: #fff;
  box-shadow: 0 6rpx 20rpx rgba(26, 22, 51, 0.04);
  animation: rise-in 0.6s cubic-bezier(0.22, 1, 0.36, 1) 0.14s both;
}
.grid-top { display: flex; margin-bottom: 20rpx; align-items: center; justify-content: space-between; }
.grid-stage { color: #6b5bc4; font-size: 23rpx; font-weight: 600; }
.view-switch { display: flex; padding: 4rpx; border-radius: 16rpx; background: #f4f5fb; }
.view-opt { padding: 8rpx 20rpx; border-radius: 12rpx; color: #8a85a5; font-size: 22rpx; transition: all 0.25s ease; }
.view-opt.active { background: #fff; color: #5a49c4; font-weight: 600; box-shadow: 0 2rpx 8rpx rgba(26, 22, 51, 0.1); }
.grid-canvas { width: 100%; }

.fallback-grid { width: 100%; }
.fg-row { display: flex; align-items: center; margin-bottom: 3rpx; }
.fg-label { width: 60rpx; flex-shrink: 0; color: #a09ab8; font-size: 18rpx; }
.fg-bar { height: 12rpx; flex: 1; border-radius: 6rpx; }
.fg-cells { display: flex; flex: 1; gap: 2rpx; }
.fg-cell { height: 20rpx; flex: 1; border-radius: 2rpx; min-width: 0; }
.cell-lived { background: #b9aef7; }
.cell-now { background: #ff9f43; }
.cell-future { background: #e4e1f5; }

.decade-blocks { display: flex; flex-wrap: wrap; gap: 14rpx; }
.decade-block {
  width: calc(50% - 7rpx); box-sizing: border-box;
  padding: 16rpx 16rpx 18rpx; border-radius: 16rpx;
  background: #f8f7fd; border: 2rpx solid #eeecf8;
}
.decade-block.current { border-color: #ffb067; background: #fffaf4; }
.db-head { display: flex; align-items: baseline; margin-bottom: 12rpx; }
.db-label { color: #3a3557; font-size: 22rpx; font-weight: 700; }
.db-stage { margin-left: 10rpx; color: #a09ab8; font-size: 18rpx; }
.db-now { margin-left: auto; color: #e07b1c; font-size: 18rpx; font-weight: 600; }
.db-cells { display: flex; gap: 4rpx; }
.db-cell {
  flex: 1; height: 40rpx; min-width: 0;
  border-radius: 6rpx; display: flex; align-items: center; justify-content: center;
}
.db-cell-age { font-size: 15rpx; color: transparent; }
.db-cell.cell-lived { background: #7c6cf0; }
.db-cell.cell-partial { background: #b9aef7; }
.db-cell.cell-now { background: #ff9f43; }
.db-cell.cell-now .db-cell-age { color: #fff; font-weight: 700; }
.db-cell.cell-future { background: #e4e1f5; }

/* 十年 · 足迹故事时间轴 */
.timeline-subhead { display: flex; margin-bottom: 24rpx; align-items: center; justify-content: space-between; }
.view-switch.sub .view-opt { padding: 8rpx 16rpx; font-size: 20rpx; }
.timeline-stat { color: #a09ab8; font-size: 20rpx; }
.tl-scroll { width: 100%; white-space: nowrap; }
.tl-track { position: relative; display: flex; padding: 8rpx 0 4rpx; min-width: 100%; }
.tl-line { position: absolute; top: 30rpx; left: 24rpx; right: 24rpx; height: 3rpx; background: #eeecf8; }
.tl-year {
  position: relative; width: 116rpx; flex-shrink: 0;
  display: flex; align-items: center; flex-direction: column;
  animation: pop-in 0.45s cubic-bezier(0.34, 1.56, 0.64, 1) both;
}
.tl-node {
  width: 22rpx; height: 22rpx; border-radius: 50%;
  background: #dcd8f0; border: 4rpx solid #fff; box-shadow: 0 0 0 2rpx #dcd8f0;
  display: flex; align-items: center; justify-content: center; z-index: 2;
}
.tl-year.lived .tl-node { background: #7c6cf0; box-shadow: 0 0 0 2rpx #7c6cf0; }
.tl-year.now .tl-node { background: #ff9f43; box-shadow: 0 0 0 4rpx rgba(255, 159, 67, 0.25); }
.tl-node-core { width: 6rpx; height: 6rpx; border-radius: 50%; background: #fff; animation: pulse 1.8s ease-in-out infinite; }
.tl-age { margin-top: 12rpx; color: #9a94b8; font-size: 20rpx; }
.tl-year.now .tl-age { color: #e07b1c; font-weight: 700; }
.tl-marks { display: flex; margin-top: 12rpx; flex-wrap: wrap; width: 100rpx; justify-content: center; gap: 4rpx; min-height: 36rpx; }
.tl-mark {
  width: 34rpx; height: 34rpx; border-radius: 10rpx;
  display: flex; align-items: center; justify-content: center; font-size: 18rpx;
  animation: pop-in 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) both;
}
.tl-more { color: #a09ab8; font-size: 18rpx; line-height: 34rpx; }
.timeline-caption { margin-top: 20rpx; padding-top: 18rpx; border-top: 1rpx solid #f2f0fa; color: #8a85a5; font-size: 21rpx; text-align: center; }
.timeline-caption.empty { color: #b0aac6; }

.grid-legend { display: flex; margin-top: 20rpx; flex-wrap: wrap; gap: 24rpx; }
.legend-item { display: flex; align-items: center; color: #6b6585; font-size: 20rpx; }
.dot { width: 16rpx; height: 16rpx; margin-right: 8rpx; border-radius: 4rpx; }
.dot-now { background: #ff9f43; }
.dot-lived { background: #7c6cf0; }
.dot-future { background: #e4e1f5; }
.grid-note { display: block; margin-top: 16rpx; color: #a09ab8; font-size: 21rpx; }

.empty-grid {
  display: flex; padding: 56rpx 24rpx; align-items: center; flex-direction: column;
  border: 2rpx dashed #cfc9ec; border-radius: 24rpx; background: #fff;
}
.empty-icon { color: #9b8ff0; font-size: 64rpx; }
.empty-text { margin-top: 16rpx; color: #6b6585; font-size: 26rpx; }
.empty-action { margin-top: 16rpx; color: #7c6cf0; font-size: 24rpx; }

.quest-list { border-radius: 24rpx; background: #fff; overflow: hidden; box-shadow: 0 6rpx 20rpx rgba(26, 22, 51, 0.04); }
.quest-item {
  display: flex; padding: 28rpx; align-items: center; justify-content: space-between;
  border-bottom: 1rpx solid #f2f0fa;
  animation: rise-in 0.5s cubic-bezier(0.22, 1, 0.36, 1) both;
}
.quest-item:last-child { border-bottom: none; }
.quest-info { flex: 1; min-width: 0; }
.quest-tags { display: flex; align-items: center; }
.type-pill { padding: 4rpx 12rpx; border-radius: 10rpx; font-size: 18rpx; font-weight: 600; }
.type-main { background: #ece8ff; color: #5a49c4; }
.type-side { background: #e0f5ee; color: #1d9e75; }
.quest-chapter { margin-left: 12rpx; color: #a09ab8; font-size: 20rpx; }
.quest-name { display: block; margin-top: 10rpx; color: #17152b; font-size: 28rpx; font-weight: 600; }
.quest-progress { height: 10rpx; margin-top: 14rpx; overflow: hidden; border-radius: 8rpx; background: #eeecf8; }
.quest-progress-fill { height: 100%; border-radius: 8rpx; background: linear-gradient(90deg, #8b7af0, #6f5ce8); transition: width 0.5s ease; }
.quest-side { display: flex; margin-left: 20rpx; align-items: flex-end; flex-direction: column; }
.quest-reward { color: #d9891c; font-size: 22rpx; font-weight: 600; }
.quick-btn {
  margin-top: 12rpx; padding: 10rpx 24rpx; border-radius: 14rpx;
  background: #6f5ce8; color: #fff; font-size: 22rpx; font-weight: 600;
  transition: transform 0.15s ease;
}
.quick-btn:active { transform: scale(0.92); }
.quest-empty { padding: 40rpx 24rpx; border-radius: 24rpx; background: #fff; color: #8a85a5; font-size: 26rpx; text-align: center; }

.badge-strip { display: flex; gap: 16rpx; }
.badge-mini {
  display: flex; flex: 1; padding: 24rpx 8rpx; align-items: center; flex-direction: column;
  border-radius: 20rpx; background: #fff; box-shadow: 0 6rpx 20rpx rgba(26, 22, 51, 0.04);
}
.badge-icon {
  display: flex; width: 56rpx; height: 56rpx; align-items: center; justify-content: center;
  border-radius: 50%; background: #fff3d6; color: #c78a12; font-size: 26rpx; font-weight: 700;
  animation: pop-in 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) both;
}
.badge-name { margin-top: 12rpx; color: #6b6585; font-size: 20rpx; }

.world-entry {
  position: relative; overflow: hidden;
  display: flex; margin-top: 32rpx; padding: 30rpx; align-items: center; border-radius: 26rpx;
  background: linear-gradient(135deg, #2a1f5e 0%, #5b45c4 100%);
  box-shadow: 0 12rpx 30rpx rgba(74, 55, 176, 0.26);
  animation: rise-in 0.6s cubic-bezier(0.22, 1, 0.36, 1) 0.1s both;
}
.we-stars {
  position: absolute; inset: 0; opacity: 0.4; pointer-events: none;
  background-image: radial-gradient(#fff 1.4rpx, transparent 1.5rpx), radial-gradient(#ffd166 1.4rpx, transparent 1.5rpx);
  background-size: 80rpx 80rpx, 120rpx 120rpx; background-position: 0 0, 30rpx 40rpx;
}
.we-icon {
  position: relative; display: flex; width: 84rpx; height: 84rpx; flex-shrink: 0;
  align-items: center; justify-content: center; border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.14); font-size: 46rpx;
}
.we-text { position: relative; display: flex; margin-left: 22rpx; flex: 1; flex-direction: column; }
.we-eyebrow { color: #c3b8ff; font-size: 17rpx; font-weight: 600; letter-spacing: 2rpx; }
.we-title { margin-top: 4rpx; color: #fff; font-size: 30rpx; font-weight: 700; }
.we-sub { margin-top: 8rpx; color: #ddd5ff; font-size: 21rpx; }
.we-bar { height: 8rpx; margin-top: 14rpx; border-radius: 6rpx; background: rgba(255, 255, 255, 0.2); overflow: hidden; }
.we-bar-fill { height: 100%; border-radius: 6rpx; background: linear-gradient(90deg, #ffd166, #ff9f43); transition: width 0.5s ease; }
.we-arrow { position: relative; color: #ddd5ff; font-size: 38rpx; }

.footprint-entry {
  display: flex; margin-top: 32rpx; padding: 30rpx; align-items: center; border-radius: 26rpx;
  background: linear-gradient(135deg, #172f4f 0%, #2f6398 100%);
  box-shadow: 0 12rpx 30rpx rgba(23, 47, 79, 0.24);
  animation: rise-in 0.6s cubic-bezier(0.22, 1, 0.36, 1) 0.2s both;
}
.fpe-icon {
  display: flex; width: 84rpx; height: 84rpx; flex-shrink: 0; align-items: center; justify-content: center;
  border-radius: 22rpx; background: rgba(255, 255, 255, 0.14); color: #ffd166; font-size: 44rpx;
}
.fpe-text { display: flex; margin-left: 22rpx; flex: 1; flex-direction: column; }
.fpe-eyebrow { color: #8fb8dd; font-size: 17rpx; font-weight: 600; letter-spacing: 2rpx; }
.fpe-title { margin-top: 4rpx; color: #fff; font-size: 30rpx; font-weight: 700; }
.fpe-sub { margin-top: 8rpx; color: #bcd6ee; font-size: 21rpx; }
.fpe-arrow { color: #bcd6ee; font-size: 38rpx; }

/* ===== 全景：人生长卷 ===== */
.overview-panel { animation: rise-in 0.5s cubic-bezier(0.22, 1, 0.36, 1) both; }
.ov-hero { padding: 30rpx; border-radius: 24rpx; background: linear-gradient(135deg, #2a1f5e 0%, #4a37b0 100%); box-shadow: 0 12rpx 30rpx rgba(74, 55, 176, 0.24); }
.ov-hero-top { display: flex; align-items: center; }
.ov-ring { width: 116rpx; height: 116rpx; flex: 0 0 116rpx; border-radius: 50%; border: 8rpx solid rgba(255,209,102,0.85); background: rgba(255,255,255,0.1); display: flex; align-items: baseline; justify-content: center; padding-top: 32rpx; box-sizing: border-box; }
.ov-ring-num { color: #ffd166; font-size: 48rpx; font-weight: 800; }
.ov-ring-unit { color: #ffd166; font-size: 22rpx; margin-left: 4rpx; }
.ov-hero-copy { display: flex; flex: 1; margin-left: 22rpx; flex-direction: column; }
.ov-eyebrow { color: #c3b8ff; font-size: 17rpx; letter-spacing: 2rpx; font-weight: 600; }
.ov-stage { color: #fff; font-size: 28rpx; font-weight: 700; margin-top: 8rpx; }
.ov-desc { color: #ddd5ff; font-size: 20rpx; margin-top: 8rpx; }
.ov-pct { color: #ffd166; font-size: 44rpx; font-weight: 800; }
.ov-pct text { font-size: 22rpx; }
.ov-main-bar { height: 14rpx; margin-top: 26rpx; border-radius: 8rpx; background: rgba(255,255,255,0.18); overflow: hidden; }
.ov-main-fill { height: 100%; border-radius: 8rpx; background: linear-gradient(90deg, #ffd166, #ff9f43); transition: width 0.5s ease; }
.ov-main-meta { display: flex; justify-content: space-between; margin-top: 12rpx; color: #c9c0ff; font-size: 20rpx; }

.ov-mile-label { margin: 30rpx 6rpx 18rpx; color: #8a85a5; font-size: 21rpx; font-weight: 600; letter-spacing: 2rpx; }
.decade-label { margin-top: 34rpx; }
.milestone-track { display: flex; padding: 8rpx 0; }
.milestone { position: relative; flex: 1; display: flex; align-items: center; flex-direction: column; }
.milestone::before { content: ''; position: absolute; top: 14rpx; left: 0; right: 0; height: 4rpx; background: #e4e1f5; }
.milestone:first-child::before { left: 50%; }
.milestone:last-child::before { right: 50%; }
.milestone.done::before, .milestone.current::before { background: #b9aef7; }
.ms-node { position: relative; z-index: 2; width: 28rpx; height: 28rpx; border-radius: 50%; background: #e4e1f5; border: 4rpx solid #fff; box-shadow: 0 0 0 2rpx #e4e1f5; display: flex; align-items: center; justify-content: center; }
.milestone.done .ms-node { background: #7c6cf0; box-shadow: 0 0 0 2rpx #7c6cf0; }
.milestone.current .ms-node { background: #ff9f43; box-shadow: 0 0 0 4rpx rgba(255,159,67,0.25); }
.ms-pulse { width: 8rpx; height: 8rpx; border-radius: 50%; background: #fff; animation: pulse 1.8s ease-in-out infinite; }
.ms-name { margin-top: 12rpx; color: #9a94b8; font-size: 21rpx; }
.milestone.done .ms-name { color: #5a49c4; font-weight: 600; }
.milestone.current .ms-name { color: #e07b1c; font-weight: 700; }
.ms-age { margin-top: 4rpx; color: #c0bbd4; font-size: 17rpx; }

.decade-bars { padding: 8rpx 24rpx; border-radius: 22rpx; background: #fff; box-shadow: 0 6rpx 20rpx rgba(26,22,51,0.04); }
.dbar-row { display: flex; align-items: center; gap: 16rpx; padding: 16rpx 0; border-bottom: 2rpx solid #f4f3f9; }
.dbar-row:last-child { border-bottom: none; }
.dbar-label { width: 92rpx; flex: 0 0 92rpx; color: #6b6590; font-size: 22rpx; font-weight: 600; }
