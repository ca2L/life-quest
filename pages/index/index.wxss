.ms-import-panel { padding: 16rpx; border-radius: 16rpx; background: #faf9fe; border: 2rpx solid #f0eef8; }
.ms-ip-input {
  width: 100%; height: 150rpx; padding: 12rpx; box-sizing: border-box;
  border-radius: 12rpx; background: #fff; color: #2c2840; font-size: 21rpx; line-height: 1.5;
}
.ms-ip-actions { display: flex; margin-top: 12rpx; }
.ms-ip-ok { flex: 1; padding: 14rpx 0; border-radius: 12rpx; background: #6f5ce8; color: #fff; font-size: 21rpx; font-weight: 600; text-align: center; }
.ms-ip-cancel { margin-left: 12rpx; padding: 14rpx 28rpx; border-radius: 12rpx; background: #eeecf6; color: #6b6585; font-size: 21rpx; text-align: center; }
.ms-tracks { margin-top: 16rpx; }
.ms-track { display: flex; margin-bottom: 10rpx; padding: 16rpx 18rpx; align-items: center; border-radius: 16rpx; background: #fff; border: 2rpx solid #f0eef8; }
.ms-track.playing { border-color: #7c6cf0; background: #f7f5ff; box-shadow: 0 6rpx 16rpx rgba(124, 108, 240, 0.12); }
.ms-track.broken { background: #fdfaf8; border-color: #f6e6dc; }
.mt-icon { display: flex; width: 48rpx; height: 48rpx; flex-shrink: 0; align-items: center; justify-content: center; border-radius: 12rpx; background: #f2f0fb; color: #5a49c4; font-size: 24rpx; }
.mt-text { display: flex; flex: 1; min-width: 0; margin-left: 16rpx; flex-direction: column; }
.mt-name { overflow: hidden; color: #17152b; font-size: 22rpx; font-weight: 600; white-space: nowrap; text-overflow: ellipsis; }
.mt-meta { margin-top: 4rpx; overflow: hidden; color: #a09ab8; font-size: 18rpx; white-space: nowrap; text-overflow: ellipsis; }
.mt-meta.warn { color: #c9772f; }
/* 改名 / 上云 竖排成一组，避免横向堆胶囊把曲名挤没 */
.mt-ops { display: flex; flex-shrink: 0; margin-right: 8rpx; flex-direction: column; align-items: flex-end; gap: 6rpx; }
.mt-edit { padding: 6rpx 14rpx; border-radius: 999rpx; background: #f2f0fb; color: #6f5ce8; font-size: 18rpx; font-weight: 600; }
.mt-cloud { padding: 6rpx 14rpx; border-radius: 999rpx; background: #eaf7f3; color: #1f8f79; font-size: 18rpx; font-weight: 600; white-space: nowrap; }
.mt-cloud.done { background: #f0f8f4; color: #4a9e86; font-weight: 500; }
.mt-cloud.busy { background: #fff4e4; color: #b8862c; }
.mt-play { width: 44rpx; text-align: center; color: #6f5ce8; font-size: 26rpx; }
.mt-play.active { color: #fff; background: #6f5ce8; border-radius: 50%; }
.mt-del { width: 40rpx; text-align: right; color: #c4bfd8; font-size: 30rpx; }
.ms-empty { padding: 24rpx; border-radius: 16rpx; background: #faf9fe; color: #a09ab8; font-size: 20rpx; text-align: center; }
.ms-player-bar { display: flex; flex-shrink: 0; padding: 14rpx 28rpx 12rpx; flex-direction: column; border-top: 2rpx solid #f2f0f8; background: #faf9ff; }
.mpb-info { display: flex; align-items: center; }
.mpb-name { flex: 1; overflow: hidden; color: #17152b; font-size: 22rpx; font-weight: 600; white-space: nowrap; text-overflow: ellipsis; }
.mpb-time { margin-left: 12rpx; color: #a09ab8; font-size: 19rpx; }
.mpb-track { height: 8rpx; margin-top: 10rpx; overflow: hidden; border-radius: 6rpx; background: #eeecf6; }
.mpb-fill { height: 100%; border-radius: 6rpx; background: linear-gradient(90deg, #9a8af5, #7c6cf0); transition: width 0.4s ease; }
.mpb-controls { display: flex; margin-top: 12rpx; align-items: center; justify-content: space-between; }
.mpb-btn { color: #6b6585; font-size: 20rpx; }
.mpb-btn.main { padding: 10rpx 26rpx; border-radius: 999rpx; background: linear-gradient(135deg, #241d52 0%, #6f5ce8 100%); color: #fff; font-size: 21rpx; font-weight: 700; }

/* MV 浮窗：组件独立于音乐弹层，关弹层只缩小不销毁；PiP 时交给系统小窗 */
.mv-float {
  /* 关掉弹层后小窗退到所有弹层之下，不挡看书 / 看正文 */
  position: fixed; z-index: 90; right: 24rpx; bottom: 32rpx;
  width: 300rpx; box-sizing: border-box; padding: 10rpx;
  border-radius: 20rpx; background: #fff;
  box-shadow: 0 12rpx 36rpx rgba(20, 16, 45, 0.28);
}
.mv-float.in-sheet {
  z-index: 115;
  left: 24rpx; right: 24rpx; width: auto; bottom: 906rpx;
  padding: 0; border-radius: 20rpx 20rpx 0 0;
  background: transparent; box-shadow: none;
}
.mv-float.pip { opacity: 0; pointer-events: none; }
.ms-video { width: 100%; height: 170rpx; border-radius: 12rpx; background: #0d0a22; }
.mv-float.in-sheet .ms-video { height: 300rpx; border-radius: 18rpx 18rpx 0 0; }
.ms-video-bar {
  display: flex; margin-top: 10rpx; padding: 0 6rpx;
  align-items: center; justify-content: space-between;
}
.ms-video-name {
  flex: 1; min-width: 0; overflow: hidden; color: #4a4664; font-size: 20rpx;
  white-space: nowrap; text-overflow: ellipsis;
}
.ms-video-pip { flex-shrink: 0; padding: 6rpx 14rpx; border-radius: 999rpx; background: #f0edff; color: #5a49c4; font-size: 18rpx; font-weight: 600; white-space: nowrap; }
.ms-video-close { flex-shrink: 0; margin-left: 12rpx; padding: 6rpx 10rpx; color: #a09ab8; font-size: 18rpx; }
.mv-float.in-sheet .ms-video-bar { padding: 0 4rpx; }

/* ===== 改名弹层：固定 px 居中卡片，不依赖 vh ===== */
.rn-mask {
  position: fixed; inset: 0; z-index: 130; display: flex;
  align-items: center; justify-content: center; padding: 0 48rpx;
  background: rgba(20, 16, 45, 0.56);
}
.rn-sheet {
  width: 100%; padding: 34rpx 32rpx 28rpx; border-radius: 28rpx; background: #fff;
  box-shadow: 0 20rpx 56rpx rgba(20, 16, 45, 0.28);
  animation: gs-up 0.24s cubic-bezier(0.22, 1, 0.36, 1) both;
}
.rn-title { display: block; color: #17152b; font-size: 30rpx; font-weight: 700; }
.rn-tip { display: block; margin-top: 8rpx; color: #a09ab8; font-size: 19rpx; line-height: 1.5; }
.rn-input {
  margin-top: 22rpx; padding: 20rpx 22rpx; height: 84rpx; box-sizing: border-box;
  border-radius: 16rpx; background: #f7f6fd; border: 2rpx solid #eeecf8;
  color: #17152b; font-size: 26rpx;
}
.rn-ph { color: #b6b1c9; }
.rn-actions { display: flex; margin-top: 26rpx; }
.rn-cancel { flex: 1; padding: 20rpx 0; border-radius: 16rpx; background: #f2f0f8; color: #6b6585; font-size: 26rpx; text-align: center; }
.rn-ok {
  flex: 1.5; margin-left: 16rpx; padding: 20rpx 0; border-radius: 16rpx;
  background: linear-gradient(135deg, #241d52 0%, #6f5ce8 100%);
  color: #fff; font-size: 26rpx; font-weight: 700; text-align: center;
}

/* ===== 书架大卡：内容预览条 ===== */
.gr-row-content {
  display: flex; margin-top: 12rpx; padding: 12rpx 16rpx; align-items: center;
  border-radius: 14rpx; background: #f7f6fd;
}
.grc-label { flex-shrink: 0; color: #5a49c4; font-size: 19rpx; font-weight: 600; }
.grc-preview { flex: 1; min-width: 0; margin-left: 12rpx; overflow: hidden; color: #8a85a5; font-size: 18rpx; white-space: nowrap; text-overflow: ellipsis; }
.grc-arrow { margin-left: 8rpx; color: #b9aef7; font-size: 22rpx; }

/* ===== 书架正文内容弹层 ===== */
.gc-mask { position: fixed; inset: 0; z-index: 101; display: flex; align-items: flex-end; background: rgba(20, 16, 45, 0.56); }
.gc-sheet {
  display: flex; width: 100%; height: 920rpx; flex-direction: column;
  border-radius: 32rpx 32rpx 0 0; background: #fff;
  box-shadow: 0 -12rpx 40rpx rgba(20, 16, 45, 0.22);
  animation: gs-up 0.28s cubic-bezier(0.22, 1, 0.36, 1) both;
}
.gc-handle { width: 72rpx; height: 8rpx; margin: 16rpx auto 0; flex-shrink: 0; border-radius: 8rpx; background: #e4e1f5; }
.gc-head { display: flex; padding: 20rpx 28rpx 16rpx; flex-shrink: 0; align-items: center; border-bottom: 2rpx solid #f2f0f8; }
.gc-head-icon {
  display: flex; width: 68rpx; height: 68rpx; flex-shrink: 0;
  align-items: center; justify-content: center; border-radius: 20rpx; background: #f2f0fb; font-size: 34rpx;
}
.gc-head-text { display: flex; margin-left: 20rpx; flex: 1; min-width: 0; flex-direction: column; }
.gc-title { color: #17152b; font-size: 29rpx; font-weight: 700; }
.gc-sub { margin-top: 4rpx; color: #8a85a5; font-size: 20rpx; }
.gc-close { width: 52rpx; text-align: right; color: #a09ab8; font-size: 40rpx; line-height: 1; }
.gc-body { flex: 1; min-height: 0; padding: 20rpx 28rpx 8rpx; box-sizing: border-box; }
.gc-item { margin-bottom: 22rpx; padding: 22rpx 22rpx 18rpx; border-radius: 22rpx; background: #faf9fe; border: 2rpx solid #f0eef8; }
.gc-item.focus { border-color: #7c6cf0; background: #f4f1ff; box-shadow: 0 8rpx 24rpx rgba(124, 108, 240, 0.14); }
.gc-item-top { display: flex; align-items: center; }
.gc-no { color: #c8c2e6; font-size: 26rpx; font-weight: 800; }
.gc-tag { margin-left: 12rpx; padding: 4rpx 12rpx; border-radius: 999rpx; background: #eeebfb; color: #5a49c4; font-size: 17rpx; font-weight: 600; }
.gc-meta { flex: 1; margin-left: 12rpx; overflow: hidden; color: #a09ab8; font-size: 17rpx; text-align: right; white-space: nowrap; text-overflow: ellipsis; }
.gc-item-title { display: block; margin-top: 12rpx; color: #17152b; font-size: 28rpx; font-weight: 700; }
.gc-intro { display: block; margin-top: 8rpx; color: #6b6585; font-size: 21rpx; line-height: 1.6; }
.gc-block { margin-top: 16rpx; }
.gc-block-label { display: block; margin-bottom: 8rpx; color: #4a37b0; font-size: 20rpx; font-weight: 700; }
.gc-line { display: flex; margin-bottom: 7rpx; align-items: flex-start; }
.gc-line-dot { width: 8rpx; height: 8rpx; margin-top: 12rpx; margin-right: 10rpx; flex-shrink: 0; border-radius: 50%; background: #a99cf2; }
.gc-line-text { flex: 1; color: #4a4664; font-size: 21rpx; line-height: 1.6; }
.gc-tip { margin-top: 16rpx; padding: 12rpx 16rpx; border-radius: 14rpx; background: #fff; border: 2rpx dashed #ded9f5; }
.gc-tip-label { color: #a09ab8; font-size: 17rpx; }
.gc-tip-text { display: block; margin-top: 4rpx; color: #5a49c4; font-size: 20rpx; line-height: 1.55; }
.gc-note { display: block; margin: 8rpx 0 20rpx; color: #a09ab8; font-size: 18rpx; line-height: 1.6; text-align: center; }
.gc-foot { display: flex; padding: 14rpx 28rpx 32rpx; flex-shrink: 0; border-top: 2rpx solid #f2f0f8; }
.gc-foot-primary {
  flex: 1; padding: 22rpx 0; border-radius: 18rpx;
  background: linear-gradient(135deg, #241d52 0%, #6f5ce8 100%);
  color: #fff; font-size: 26rpx; font-weight: 700; text-align: center;
}
.gc-foot-cancel { margin-left: 16rpx; padding: 22rpx 34rpx; border-radius: 18rpx; background: #f2f0f8; color: #6b6585; font-size: 26rpx; text-align: center; }

/* 人生书架 → 我的书架（真实已读数据入口） */
.hbe-entry {
  display: flex; align-items: center; gap: 18rpx;
  margin: 0 0 24rpx; padding: 22rpx 24rpx;
  border-radius: 22rpx; background: linear-gradient(100deg, #efecff, #f8f6ff);
  border: 2rpx solid #ded7ff;
}
.hbe-icon { font-size: 40rpx; }
.hbe-body { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.hbe-title { color: #4b3fb0; font-size: 26rpx; font-weight: 700; }
.hbe-sub { color: #8a84b5; font-size: 21rpx; margin-top: 6rpx; line-height: 1.5; }
.hbe-arrow { color: #6f5ce8; font-size: 36rpx; }
