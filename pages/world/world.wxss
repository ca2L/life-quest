.page { min-height: 100vh; background: #f4f5fb; padding-bottom: 60rpx; }
.content { padding: 30rpx 28rpx; }

/* 通用状态 */
.state-card { min-height: 100vh; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 40rpx; }
.spinner { width: 64rpx; height: 64rpx; border: 6rpx solid #e4e1f5; border-top-color: #7c6cf0; border-radius: 50%; animation: spin 0.9s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }
.state-title { margin-top: 28rpx; color: #6b6590; font-size: 28rpx; }
.login-wrap { background: linear-gradient(160deg, #1a1633 0%, #2a2152 100%); }
.login-hero { margin-bottom: 50rpx; text-align: center; }
.login-eyebrow { display: block; color: #a99cf5; font-size: 22rpx; letter-spacing: 4rpx; margin-bottom: 20rpx; }
.login-title { display: block; color: #fff; font-size: 52rpx; font-weight: 800; line-height: 1.35; }
.login-desc { display: block; color: #b9b2d8; font-size: 26rpx; margin-top: 22rpx; }
.error-bar { padding: 24rpx; margin: 20rpx 0; border-radius: 16rpx; background: #fff0ec; color: #c14a2b; font-size: 26rpx; text-align: center; }

/* 顶部英雄卡 */
.world-hero {
  position: relative; overflow: hidden;
  padding: 40rpx 36rpx 36rpx;
  border-radius: 30rpx;
  background: linear-gradient(135deg, #2a1f5e 0%, #4a37b0 55%, #6f5ce8 100%);
  box-shadow: 0 18rpx 44rpx rgba(74, 55, 176, 0.28);
}
.wh-stars {
  position: absolute; inset: 0; opacity: 0.5; pointer-events: none;
  background-image: radial-gradient(#fff 1.5rpx, transparent 1.6rpx), radial-gradient(#ffd166 1.5rpx, transparent 1.6rpx);
  background-size: 90rpx 90rpx, 140rpx 140rpx;
  background-position: 0 0, 40rpx 60rpx;
}
.wh-top { position: relative; }
.wh-eyebrow { display: block; color: #c3b8ff; font-size: 20rpx; letter-spacing: 3rpx; margin-bottom: 12rpx; }
.wh-title { display: block; color: #fff; font-size: 46rpx; font-weight: 800; letter-spacing: 1rpx; }
.wh-sub { display: block; color: #ddd5ff; font-size: 24rpx; margin-top: 12rpx; }
.wh-progress { position: relative; display: flex; align-items: center; gap: 28rpx; margin-top: 34rpx; padding: 26rpx; border-radius: 22rpx; background: rgba(255, 255, 255, 0.12); backdrop-filter: blur(6px); }
.whp-ring {
  width: 128rpx; height: 128rpx; flex: 0 0 128rpx; border-radius: 50%;
  border: 10rpx solid rgba(255, 255, 255, 0.2); border-top-color: #ffd166;
  display: flex; align-items: baseline; justify-content: center; padding-top: 34rpx; box-sizing: border-box;
}
.whp-num { color: #ffd166; font-size: 48rpx; font-weight: 800; }
.whp-unit { color: #ffd166; font-size: 24rpx; }
.whp-copy { flex: 1; }
.whp-title { display: block; color: #fff; font-size: 28rpx; font-weight: 700; }
.whp-detail { display: block; color: #e0d9ff; font-size: 23rpx; margin: 8rpx 0 16rpx; }
.whp-bar { height: 12rpx; border-radius: 8rpx; background: rgba(255, 255, 255, 0.2); overflow: hidden; }
.whp-fill { height: 100%; border-radius: 8rpx; background: linear-gradient(90deg, #ffd166, #ff9f43); transition: width 0.5s ease; }
.whp-caption { display: block; color: #c9c0ff; font-size: 19rpx; margin-top: 10rpx; }

/* 分区标题 */
.section-head { display: flex; align-items: flex-end; justify-content: space-between; margin: 44rpx 6rpx 22rpx; }
.section-title-wrap { display: flex; flex-direction: column; }
.section-eyebrow { color: #a09ab8; font-size: 19rpx; letter-spacing: 3rpx; font-weight: 600; }
.section-title { color: #17152b; font-size: 36rpx; font-weight: 800; margin-top: 6rpx; }
.section-tip { color: #8b85a8; font-size: 23rpx; }

/* 分区筛选 */
.realm-filter { white-space: nowrap; margin-bottom: 20rpx; }
.realm-chip { display: inline-block; padding: 14rpx 26rpx; margin-right: 14rpx; border-radius: 30rpx; background: #fff; color: #6b6590; font-size: 24rpx; box-shadow: 0 4rpx 14rpx rgba(26, 22, 51, 0.04); }
.realm-chip.active { background: #6f5ce8; color: #fff; font-weight: 600; }

/* 幻想大陆卡片 */
.realm-list { display: flex; flex-direction: column; gap: 18rpx; }
.realm-card { padding: 26rpx; border-radius: 24rpx; background: #fff; box-shadow: 0 8rpx 24rpx rgba(26, 22, 51, 0.05); animation: rise-in 0.45s cubic-bezier(0.22, 1, 0.36, 1) both; }
@keyframes rise-in { from { opacity: 0; transform: translateY(16rpx); } to { opacity: 1; transform: translateY(0); } }
.realm-head { display: flex; align-items: center; gap: 18rpx; margin-bottom: 22rpx; }
.realm-badge { width: 68rpx; height: 68rpx; flex: 0 0 68rpx; border-radius: 18rpx; display: flex; align-items: center; justify-content: center; font-size: 36rpx; box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.1); }
.realm-meta { flex: 1; display: flex; flex-direction: column; }
.realm-name { color: #1a1730; font-size: 30rpx; font-weight: 700; }
.realm-stat { color: #6f5ce8; font-size: 22rpx; margin-top: 6rpx; }
.realm-stat.dim { color: #b0aac4; }
.realm-pct { font-size: 28rpx; font-weight: 800; }
.tile-row { display: flex; gap: 14rpx; }
.tile {
  flex: 1; height: 112rpx; border-radius: 16rpx;
  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8rpx;
  position: relative; overflow: hidden;
}
.tile.fog { background: #eeecf6; border: 2rpx dashed #d9d5e8; }
.tile.lit { box-shadow: 0 6rpx 18rpx rgba(0, 0, 0, 0.12); }
.tile.lv-3 { border: 3rpx solid #ffd166; }
.tile-icon { font-size: 34rpx; }
.tile.lit .tile-icon { filter: drop-shadow(0 2rpx 4rpx rgba(0, 0, 0, 0.2)); }
.tile-name { font-size: 21rpx; font-weight: 600; }
.tile.fog .tile-name { color: #b0aac4; font-weight: 400; }
.tile.lit .tile-name { color: #fff; }

.world-hint { display: flex; flex-direction: column; align-items: center; padding: 50rpx 30rpx; border-radius: 24rpx; background: #fff; box-shadow: 0 8rpx 24rpx rgba(26, 22, 51, 0.05); }
.wh-icon { font-size: 72rpx; }
.wh-text { color: #3a3557; font-size: 30rpx; font-weight: 700; margin-top: 16rpx; }
.wh-action { color: #6f5ce8; font-size: 24rpx; margin-top: 12rpx; }

/* 角色卡 */
.add-role { padding: 12rpx 24rpx; border-radius: 24rpx; background: #6f5ce8; color: #fff; font-size: 24rpx; font-weight: 600; }
.companion-summary { display: flex; align-items: center; padding: 26rpx; margin-bottom: 20rpx; border-radius: 22rpx; background: linear-gradient(135deg, #4a37b0, #6f5ce8); }
.cs-item { flex: 1; display: flex; flex-direction: column; align-items: center; }
.cs-num { color: #ffd166; font-size: 36rpx; font-weight: 800; }
.cs-label { color: #ddd5ff; font-size: 21rpx; margin-top: 6rpx; }
.cs-emoji { font-size: 36rpx; }
.cs-divider { width: 2rpx; height: 44rpx; background: rgba(255, 255, 255, 0.22); }
.companion-list { display: flex; flex-direction: column; gap: 16rpx; }
.companion-card { padding: 26rpx; border-radius: 24rpx; background: #fff; box-shadow: 0 8rpx 24rpx rgba(26, 22, 51, 0.05); animation: rise-in 0.45s cubic-bezier(0.22, 1, 0.36, 1) both; }
.cc-top { display: flex; align-items: center; gap: 18rpx; }
.cc-avatar { width: 80rpx; height: 80rpx; flex: 0 0 80rpx; border-radius: 22rpx; display: flex; align-items: center; justify-content: center; font-size: 44rpx; box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.12); }
.cc-meta { flex: 1; display: flex; flex-direction: column; }
.cc-name-row { display: flex; align-items: center; gap: 12rpx; }
.cc-name { color: #17152b; font-size: 30rpx; font-weight: 700; }
.cc-relation { padding: 4rpx 14rpx; border-radius: 10rpx; background: #f0edfb; color: #6f5ce8; font-size: 20rpx; }
.cc-level { display: flex; align-items: center; justify-content: space-between; margin-top: 8rpx; font-size: 23rpx; font-weight: 600; }
.cc-value { color: #a09ab8; font-size: 21rpx; font-weight: 400; }
.cc-edit { padding: 8rpx 18rpx; border-radius: 12rpx; background: #f5f4fb; color: #6f5ce8; font-size: 22rpx; }
.cc-bar { height: 10rpx; border-radius: 8rpx; background: #eeecf6; margin: 20rpx 0 14rpx; overflow: hidden; }
.cc-bar-fill { height: 100%; border-radius: 8rpx; transition: width 0.5s ease; }
.cc-foot { display: flex; align-items: center; gap: 16rpx; }
.cc-meet { color: #6b6590; font-size: 22rpx; }
.cc-next { flex: 1; color: #a09ab8; font-size: 21rpx; text-align: right; }
.cc-next.max { color: #f5a623; }
.cc-del { color: #c9c4d8; font-size: 21rpx; }
.cc-last { color: #2f9e8f; font-size: 20rpx; }
.cc-verify { margin-top: 16rpx; padding: 12rpx 18rpx; border-radius: 14rpx; background: #f5f3ff; color: #6f5ce8; font-size: 21rpx; }
.cc-shared { margin-top: 12rpx; padding: 18rpx; border-radius: 16rpx; background: #faf9ff; border: 2rpx solid #ece8ff; }
.cs-list { display: flex; flex-direction: column; gap: 12rpx; }
.cs-row { display: flex; align-items: flex-start; gap: 14rpx; }
.cs-date { flex: 0 0 150rpx; color: #8a85a5; font-size: 20rpx; }
.cs-title { flex: 1; min-width: 0; color: #3a3557; font-size: 22rpx; line-height: 1.5; }
.cs-place { flex: 0 0 auto; max-width: 160rpx; color: #6f5ce8; font-size: 20rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.cs-more { color: #a09ab8; font-size: 20rpx; margin-top: 6rpx; }
.cs-empty { color: #8a85a5; font-size: 22rpx; line-height: 1.6; }
.cs-link { align-self: flex-start; margin-top: 14rpx; padding: 10rpx 20rpx; border-radius: 14rpx; background: #efecff; color: #6f5ce8; font-size: 21rpx; }

.truth-note { display: flex; flex-direction: column; gap: 8rpx; margin: -4rpx 0 22rpx; padding: 20rpx 24rpx; border-radius: 18rpx; background: #fffaf0; border: 2rpx solid #f2e2c4; }
.tn-line { color: #8a6d3b; font-size: 21rpx; line-height: 1.65; }
.tn-line.warn { color: #b5591c; }

.companion-empty { display: flex; flex-direction: column; align-items: center; padding: 56rpx 34rpx; border-radius: 24rpx; background: #fff; box-shadow: 0 8rpx 24rpx rgba(26, 22, 51, 0.05); }
.ce-icon { font-size: 72rpx; }
.ce-title { color: #3a3557; font-size: 30rpx; font-weight: 700; margin-top: 16rpx; }
.ce-desc { color: #9a94b8; font-size: 23rpx; text-align: center; line-height: 1.6; margin-top: 12rpx; }
.ce-cta { margin-top: 24rpx; padding: 16rpx 34rpx; border-radius: 24rpx; background: #6f5ce8; color: #fff; font-size: 24rpx; font-weight: 600; }

.footer-note { display: block; text-align: center; color: #b0aac4; font-size: 21rpx; margin-top: 44rpx; }

/* 弹层 */
.modal-mask { position: fixed; inset: 0; background: rgba(20, 16, 40, 0.5); display: flex; align-items: flex-end; z-index: 100; }
/* 固定高度（兜底 88vh；真机由内联 px 覆盖），scroll-view 才能拿到确定高度去滚动 */
.form-sheet { width: 100%; height: 88vh; background: #fff; border-radius: 32rpx 32rpx 0 0; display: flex; flex-direction: column; box-shadow: 0 -8rpx 40rpx rgba(0, 0, 0, 0.12); }
.sheet-handle { width: 72rpx; height: 8rpx; border-radius: 6rpx; background: #e4e1f5; margin: 18rpx auto 6rpx; flex-shrink: 0; }
.form-head { display: flex; align-items: center; justify-content: space-between; padding: 16rpx 36rpx 20rpx; border-bottom: 2rpx solid #f2f1f8; flex-shrink: 0; }
.form-title { color: #17152b; font-size: 32rpx; font-weight: 800; }
.form-close { color: #a09ab8; font-size: 32rpx; padding: 8rpx; }
.form-body { flex: 1; min-height: 0; padding: 24rpx 36rpx 0; box-sizing: border-box; }
.field { margin-bottom: 30rpx; }
.field-label { display: flex; align-items: center; margin-bottom: 14rpx; color: #3a3557; font-size: 26rpx; font-weight: 600; }
.required { color: #e0603b; margin-left: 6rpx; }
.field-input {
  width: 100%; box-sizing: border-box; height: 88rpx; line-height: 88rpx;
  padding: 0 24rpx; border-radius: 16rpx;
  background: #f5f4fb; color: #17152b; font-size: 28rpx;
}
.avatar-grid { display: flex; flex-wrap: wrap; gap: 14rpx; }
.avatar-opt { width: 80rpx; height: 80rpx; display: flex; align-items: center; justify-content: center; font-size: 42rpx; border-radius: 18rpx; background: #f5f4fb; border: 4rpx solid transparent; }
.avatar-opt.active { border-color: #6f5ce8; background: #efecff; }
.chip-row { display: flex; flex-wrap: wrap; gap: 12rpx; }
.rel-chip { padding: 12rpx 24rpx; border-radius: 24rpx; background: #f5f4fb; color: #6b6590; font-size: 24rpx; }
.rel-chip.active { background: #6f5ce8; color: #fff; font-weight: 600; }
.color-row { display: flex; gap: 16rpx; }
.color-opt { width: 60rpx; height: 60rpx; border-radius: 50%; border: 5rpx solid transparent; box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1); }
.color-opt.active { border-color: #17152b; }
.form-error { color: #c14a2b; font-size: 24rpx; margin-bottom: 16rpx; }
.form-pad { height: 40rpx; }
.form-footer { display: flex; gap: 20rpx; padding: 20rpx 36rpx 40rpx; border-top: 2rpx solid #f2f1f8; flex-shrink: 0; }
.btn-cancel, .btn-save { flex: 1; height: 88rpx; line-height: 88rpx; text-align: center; border-radius: 20rpx; font-size: 28rpx; font-weight: 600; }
.btn-cancel { background: #f0eef8; color: #6b6590; }
.btn-save { background: #6f5ce8; color: #fff; }
.btn-save.disabled { opacity: 0.6; }

/* 主视图切换 */
.main-tabs { display: flex; gap: 12rpx; margin-top: 28rpx; padding: 8rpx; border-radius: 20rpx; background: #eceaf5; }
.main-tabs.three { gap: 6rpx; }
.main-tabs.three .main-tab { font-size: 23rpx; padding: 16rpx 0; }
.main-tab { flex: 1; padding: 18rpx 0; border-radius: 14rpx; text-align: center; color: #7a7496; font-size: 26rpx; font-weight: 600; transition: all 0.25s ease; }
.main-tab.active { background: #fff; color: #5a49c4; box-shadow: 0 4rpx 14rpx rgba(26, 22, 51, 0.08); }
.mt-badge { display: inline-block; min-width: 32rpx; padding: 2rpx 8rpx; margin-left: 6rpx; border-radius: 12rpx; background: #ece8ff; color: #5a49c4; font-size: 20rpx; }

/* 真实地图 */
.map-toolbar { display: flex; align-items: center; justify-content: space-between; margin: 28rpx 4rpx 16rpx; }
.map-toolbar-label { color: #a09ab8; font-size: 20rpx; letter-spacing: 1rpx; }
.map-mode-switch { display: flex; padding: 4rpx; border-radius: 14rpx; background: #eceaf5; }
.mm-opt { padding: 8rpx 22rpx; border-radius: 10rpx; color: #8a85a5; font-size: 22rpx; }
.mm-opt.active { background: #fff; color: #5a49c4; font-weight: 600; box-shadow: 0 2rpx 8rpx rgba(26, 22, 51, 0.08); }
.map-wrap { position: relative; border-radius: 24rpx; overflow: hidden; box-shadow: 0 8rpx 24rpx rgba(26, 22, 51, 0.08); }
.real-map { width: 100%; height: 620rpx; display: block; }
.map-tip { position: absolute; left: 20rpx; bottom: 20rpx; right: 20rpx; padding: 14rpx 18rpx; border-radius: 12rpx; background: rgba(26, 22, 51, 0.72); color: #fff; font-size: 21rpx; text-align: center; backdrop-filter: blur(4px); }

/* 地点清单 */
.place-list { padding: 24rpx; border-radius: 24rpx; background: #fff; box-shadow: 0 8rpx 24rpx rgba(26, 22, 51, 0.05); }
.place-head { display: flex; align-items: center; justify-content: space-between; padding-bottom: 18rpx; border-bottom: 2rpx solid #f2f1f8; }
.place-head-title { color: #17152b; font-size: 28rpx; font-weight: 700; }
.place-head-count { color: #6f5ce8; font-size: 23rpx; font-weight: 600; }
.place-item { display: flex; align-items: center; gap: 16rpx; padding: 22rpx 0; border-bottom: 2rpx solid #f6f5fa; }
.place-item:last-of-type { border-bottom: none; }
.place-pin { width: 56rpx; height: 56rpx; flex: 0 0 56rpx; display: flex; align-items: center; justify-content: center; border-radius: 16rpx; background: #efecff; font-size: 30rpx; }
.place-info { flex: 1; display: flex; flex-direction: column; }
.place-name { color: #2a2740; font-size: 27rpx; font-weight: 600; }
.place-meta { color: #a09ab8; font-size: 21rpx; margin-top: 6rpx; }
.place-arrow { color: #c9c4d8; font-size: 36rpx; }
.place-note { color: #a09ab8; font-size: 20rpx; text-align: center; padding-top: 18rpx; }
.map-empty { display: flex; flex-direction: column; align-items: center; padding: 50rpx 30rpx; border-radius: 24rpx; background: #fff; box-shadow: 0 8rpx 24rpx rgba(26, 22, 51, 0.05); }
.me-icon { font-size: 68rpx; }
.me-title { color: #3a3557; font-size: 28rpx; font-weight: 700; margin-top: 14rpx; }
.me-desc { color: #9a94b8; font-size: 23rpx; text-align: center; line-height: 1.6; margin-top: 10rpx; }
.me-cta { margin-top: 22rpx; padding: 14rpx 30rpx; border-radius: 22rpx; background: #6f5ce8; color: #fff; font-size: 23rpx; font-weight: 600; }

/* 角色卡视图 */
.role-head { margin-top: 32rpx; }
.cc-avatar { position: relative; overflow: hidden; }
.cc-avatar-img { width: 100%; height: 100%; }
.cc-met { color: #a09ab8; font-size: 20rpx; margin-top: 8rpx; }
.cc-story { margin: 4rpx 0 16rpx; padding: 16rpx 20rpx; border-radius: 14rpx; background: #faf9fe; color: #6b6590; font-size: 23rpx; line-height: 1.6; border-left: 4rpx solid #e4dfff; }

/* 头像上传 */
.avatar-upload-row { display: flex; align-items: center; gap: 20rpx; margin-bottom: 18rpx; }
.avatar-preview { width: 112rpx; height: 112rpx; flex: 0 0 112rpx; border-radius: 24rpx; display: flex; align-items: center; justify-content: center; font-size: 56rpx; overflow: hidden; box-shadow: 0 6rpx 16rpx rgba(0,0,0,0.1); }
.avatar-preview-img { width: 100%; height: 100%; }
.avatar-actions { display: flex; flex-direction: column; gap: 10rpx; }
.avatar-upload-btn { padding: 14rpx 24rpx; border-radius: 14rpx; background: #efecff; color: #5a49c4; font-size: 24rpx; font-weight: 600; text-align: center; }
.avatar-clear { color: #e0603b; font-size: 21rpx; }
.avatar-tip { color: #a09ab8; font-size: 20rpx; }
.date-row { display: flex; align-items: center; gap: 16rpx; }
.date-picker { padding: 18rpx 24rpx; border-radius: 14rpx; background: #f5f4fb; color: #3a3557; font-size: 26rpx; }
.date-clear { color: #e0603b; font-size: 22rpx; }
.field-textarea { width: 100%; box-sizing: border-box; min-height: 140rpx; padding: 20rpx 24rpx; border-radius: 14rpx; background: #f5f4fb; color: #17152b; font-size: 26rpx; line-height: 1.6; }

/* ===== 航旅式行程看板（借鉴航旅纵横 / 高德统计页，紫色游戏化风格） ===== */
/* 年份时间轴 */
.year-bar { display: flex; white-space: nowrap; margin-top: 4rpx; padding-bottom: 6rpx; }
.year-chip {
  display: inline-flex; align-items: center; justify-content: center;
  padding: 14rpx 30rpx; margin-right: 14rpx;
  border-radius: 24rpx; background: #eceaf5; color: #7a7496;
  font-size: 25rpx; font-weight: 600;
}
.year-chip.active { background: linear-gradient(100deg, #6f5ce8, #8a5ce0); color: #fff; box-shadow: 0 6rpx 16rpx rgba(111, 92, 232, 0.28); }

/* 看板主卡 */
/* 旅程分享卡：足迹旅记式发光深色卡（沿用品牌紫，不照搬参考色） */
.travel-board {
  margin-top: 20rpx; padding: 30rpx 32rpx 28rpx;
  border-radius: 32rpx;
  background: radial-gradient(130% 110% at 50% 0%, #2c2260 0%, #1a1440 52%, #100c2a 100%);
  border: 1rpx solid rgba(167, 140, 250, 0.4);
  box-shadow: 0 0 50rpx rgba(124, 108, 240, 0.32), 0 18rpx 44rpx rgba(20, 12, 50, 0.3), inset 0 0 70rpx rgba(124, 108, 240, 0.1);
  color: #fff;
  position: relative; overflow: hidden;
}
.travel-board::after {
  content: ''; position: absolute; right: -70rpx; top: -90rpx;
  width: 320rpx; height: 320rpx; border-radius: 50%;
  background: radial-gradient(circle, rgba(143, 123, 245, 0.4), transparent 70%);
}
.tb-head { display: flex; align-items: center; justify-content: space-between; position: relative; z-index: 1; }
.tb-eyebrow { font-size: 19rpx; font-weight: 700; letter-spacing: 2rpx; color: #a99cf2; }
.tb-badges { display: flex; align-items: center; gap: 12rpx; }
.tb-mile { font-size: 20rpx; color: #e6dffb; background: rgba(143, 123, 245, 0.28); padding: 6rpx 16rpx; border-radius: 999rpx; }
.tb-year { font-size: 21rpx; color: #cfc9ea; background: rgba(255,255,255,0.1); padding: 6rpx 16rpx; border-radius: 999rpx; }

/* 霓虹大标题：足迹旅记式发光 */
.tb-hero { display: flex; margin-top: 26rpx; align-items: center; flex-direction: column; position: relative; z-index: 1; }
.tb-line1 { font-size: 24rpx; color: #b9b1de; letter-spacing: 2rpx; }
.tb-big {
  margin-top: 10rpx;
  font-size: 52rpx; font-weight: 800; letter-spacing: 2rpx;
  color: #e6ddff;
  text-shadow: 0 0 22rpx rgba(148, 118, 255, 0.95), 0 0 60rpx rgba(124, 108, 240, 0.55);
}

/* 三格统计：省 / 城 / 旅行（分享卡同构，竖线分隔 + 发光数字） */
.tb-share-stats { display: flex; margin-top: 30rpx; align-items: center; justify-content: space-around; position: relative; z-index: 1; }
.tss-item { display: flex; align-items: center; flex-direction: column; }
.tss-num { font-size: 44rpx; font-weight: 800; color: #ffffff; text-shadow: 0 0 18rpx rgba(148, 118, 255, 0.7); }
.tss-label { margin-top: 6rpx; font-size: 19rpx; color: #9c92c9; }
.tss-divider { width: 1rpx; height: 52rpx; background: rgba(255, 255, 255, 0.16); }
/* 点亮省份：格子省份图（默认）+ 高德式电量条，两种样式可切换 */
.pb-section { margin-top: 20rpx; padding-top: 20rpx; border-top: 2rpx solid rgba(255,255,255,0.1); position: relative; z-index: 1; }
.pb-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16rpx; }
.pb-title-wrap { display: flex; flex-direction: column; }
.pb-title { font-size: 24rpx; font-weight: 700; color: #efeafc; }
.pb-total { margin-top: 4rpx; font-size: 20rpx; color: #a99cf2; }
/* 图表样式切换（地图/清单工具条同构） */
.pb-view-switch { display: flex; background: rgba(255,255,255,0.1); border-radius: 999rpx; padding: 4rpx; flex-shrink: 0; }
.pb-view-switch.three .pv-opt { padding: 6rpx 12rpx; font-size: 18rpx; }
.pv-opt { font-size: 20rpx; color: #b9aee8; padding: 6rpx 18rpx; border-radius: 999rpx; transition: all 0.2s; }
.pv-opt.active { background: linear-gradient(135deg, #7c6cf0, #9a7bf5); color: #ffffff; font-weight: 700; box-shadow: 0 4rpx 14rpx rgba(124, 108, 240, 0.45); }

/* 真实省界图：canvas 主路径 / SVG 图片兜底 */
.cm-wrap { margin-top: 8rpx; border-radius: 18rpx; overflow: hidden; background: #171233; }
.cm-canvas { width: 100%; height: 518rpx; display: block; }
.cm-image { width: 100%; display: block; }
.cm-note { display: block; padding: 10rpx 16rpx 14rpx; font-size: 17rpx; color: #7a6fac; line-height: 1.5; }

/* 全球足迹 */
.global-hero { margin-top: 26rpx; padding: 34rpx 30rpx 30rpx; border-radius: 26rpx; background: radial-gradient(120% 120% at 10% 0%, #3a2f7d 0%, #1b1538 60%, #14102c 100%); box-shadow: 0 10rpx 30rpx rgba(60, 40, 140, 0.22); }
.gh-eyebrow { font-size: 19rpx; letter-spacing: 2rpx; color: #a99cf2; }
.gh-title { display: block; margin-top: 12rpx; font-size: 38rpx; font-weight: 800; color: #ffffff; text-shadow: 0 0 22rpx rgba(148, 118, 255, 0.6); }
.gh-sub { display: block; margin-top: 8rpx; font-size: 21rpx; color: #b3a9dd; }
.gh-stats { display: flex; align-items: center; justify-content: space-around; margin-top: 28rpx; }
.ghs-item { display: flex; flex-direction: column; align-items: center; }
.ghs-num { font-size: 38rpx; font-weight: 800; color: #fff; text-shadow: 0 0 16rpx rgba(148, 118, 255, 0.6); }
.ghs-label { margin-top: 4rpx; font-size: 19rpx; color: #9c92c9; }
.ghs-divider { width: 1rpx; height: 48rpx; background: rgba(255,255,255,0.16); }

.global-map-card { margin-top: 24rpx; padding: 20rpx; border-radius: 24rpx; background: #fff; box-shadow: 0 8rpx 24rpx rgba(26, 22, 51, 0.06); }
.gmc-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16rpx; }
.gmc-title { font-size: 24rpx; font-weight: 700; color: #2a2450; }
.gmc-scale { font-size: 20rpx; color: #7a7496; }
.global-map { width: 100%; height: 500rpx; display: block; border-radius: 16rpx; }
.gmc-fallback { height: 240rpx; display: flex; align-items: center; justify-content: center; border-radius: 16rpx; background: #f4f2fb; color: #8b85a8; font-size: 22rpx; text-align: center; padding: 0 30rpx; }
.gmc-note { display: block; margin-top: 14rpx; font-size: 18rpx; color: #9a94b8; line-height: 1.5; }
.gmc-action { display: flex; margin-top: 16rpx; padding: 18rpx 20rpx; align-items: center; justify-content: space-between; border-radius: 16rpx; background: #eef0ff; }
.gmc-action-text { color: #5a49c4; font-size: 21rpx; font-weight: 600; }
.gmc-action-arrow { color: #7c6cf0; font-size: 26rpx; }

.continent-group { margin-top: 24rpx; }
.cg-head { display: flex; align-items: center; margin: 0 6rpx 14rpx; }
.cg-icon { font-size: 26rpx; margin-right: 10rpx; }
.cg-name { font-size: 26rpx; font-weight: 700; color: #2a2450; }
.cg-count { margin-left: auto; font-size: 20rpx; color: #8b85a8; }
.country-grid { display: flex; flex-wrap: wrap; }
.country-card { width: calc(33.33% - 10rpx); margin: 0 10rpx 14rpx 0; padding: 18rpx 10rpx; border-radius: 18rpx; background: #fff; box-shadow: 0 4rpx 16rpx rgba(26, 22, 51, 0.05); display: flex; flex-direction: column; align-items: center; }
.country-card:nth-child(3n) { margin-right: 0; }
.country-card.lit { background: linear-gradient(150deg, #f1edff, #e7e0ff); box-shadow: 0 4rpx 18rpx rgba(124, 108, 240, 0.18); }
.ct-flag { font-size: 40rpx; line-height: 1.2; }
.ct-name { margin-top: 8rpx; font-size: 23rpx; font-weight: 700; color: #2a2450; }
.ct-count { margin-top: 4rpx; font-size: 18rpx; color: #6f5ce8; }
.ct-place { margin-top: 4rpx; font-size: 17rpx; color: #9a94b8; max-width: 100%; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }

.global-empty { display: flex; flex-direction: column; align-items: center; margin-top: 26rpx; padding: 56rpx 30rpx; border-radius: 24rpx; background: #fff; box-shadow: 0 8rpx 24rpx rgba(26, 22, 51, 0.05); }
.ge-icon { font-size: 64rpx; }
.ge-title { margin-top: 18rpx; font-size: 28rpx; font-weight: 700; color: #2a2450; }
.ge-desc { margin-top: 12rpx; font-size: 22rpx; color: #8b85a8; text-align: center; line-height: 1.6; }
.ge-cta { margin-top: 22rpx; padding: 14rpx 34rpx; border-radius: 999rpx; background: linear-gradient(135deg, #7c6cf0, #9a7bf5); color: #fff; font-size: 23rpx; font-weight: 700; }

/* 格子省份图：抽象网格近似地理方位，不绘制真实省界（合规） */
.pg-map { position: relative; width: 100%; height: 640rpx; margin-top: 6rpx; }
.pg-cell { position: absolute; width: 8.4%; height: 11.6%; border-radius: 12rpx; background: rgba(255,255,255,0.07); border: 1rpx solid rgba(255,255,255,0.08); display: flex; flex-direction: column; align-items: center; justify-content: center; transition: transform 0.2s; }
.pg-cell .pg-abbr { font-size: 22rpx; font-weight: 600; color: rgba(255,255,255,0.34); line-height: 1.1; }
.pg-cell .pg-count { font-size: 16rpx; color: rgba(255,255,255,0.0); line-height: 1.2; }
.pg-cell.lit { background: linear-gradient(150deg, #8b78ff, #6f5ce8); border-color: rgba(255,255,255,0.35); box-shadow: 0 0 18rpx rgba(124, 108, 240, 0.65), inset 0 1rpx 0 rgba(255,255,255,0.25); animation: pg-glow 2.4s ease-in-out infinite alternate; }
.pg-cell.lit .pg-abbr { color: #ffffff; text-shadow: 0 0 8rpx rgba(255,255,255,0.5); }
.pg-cell.lit .pg-count { color: #ffe9b8; font-weight: 700; }
@keyframes pg-glow { from { box-shadow: 0 0 10rpx rgba(124, 108, 240, 0.45); } to { box-shadow: 0 0 24rpx rgba(148, 118, 255, 0.8); } }
.pg-legend { display: flex; align-items: center; justify-content: center; margin-top: 14rpx; }
.pg-legend-dot { width: 16rpx; height: 16rpx; border-radius: 5rpx; background: rgba(255,255,255,0.12); margin-right: 8rpx; }
.pg-legend-dot.lit { background: linear-gradient(150deg, #8b78ff, #6f5ce8); margin-left: 20rpx; }
.pg-legend-text { font-size: 19rpx; color: #a99cf2; margin-right: 12rpx; }

/* 电量条样式 */
.pb-row { display: flex; align-items: center; margin-bottom: 14rpx; animation: pb-rise 0.45s cubic-bezier(0.22, 1, 0.36, 1) both; }
.pb-row:nth-child(2) { animation-delay: 0.06s; }
.pb-row:nth-child(3) { animation-delay: 0.12s; }
.pb-row:nth-child(4) { animation-delay: 0.18s; }
.pb-row:nth-child(5) { animation-delay: 0.24s; }
@keyframes pb-rise { from { opacity: 0; transform: translateX(-16rpx); } to { opacity: 1; transform: translateX(0); } }
.pb-name { flex-shrink: 0; width: 132rpx; font-size: 22rpx; color: #ded8f7; }
.pb-battery { flex: 1; display: flex; align-items: center; min-width: 0; }
.pb-track { flex: 1; height: 22rpx; border-radius: 8rpx; background: rgba(255,255,255,0.14); overflow: hidden; }
.pb-fill { height: 100%; border-radius: 8rpx; background: linear-gradient(90deg, #7c6cf0, #a56bf0); transform-origin: left center; animation: pb-charge 0.7s cubic-bezier(0.22, 1, 0.36, 1) both; }
@keyframes pb-charge { from { transform: scaleX(0); } to { transform: scaleX(1); } }
.pb-row.full .pb-fill { background: linear-gradient(90deg, #ffd166, #ff9f43); }
.pb-cap { flex-shrink: 0; width: 7rpx; height: 14rpx; margin-left: 5rpx; border-radius: 0 5rpx 5rpx 0; background: rgba(255,255,255,0.3); }
.pb-count { flex-shrink: 0; width: 62rpx; text-align: right; font-size: 24rpx; font-weight: 700; color: #ffffff; }
.pb-unit { margin-left: 2rpx; font-size: 18rpx; font-weight: 400; color: #a99cf2; }

/* 地图图例 */
.map-tip { display: flex; align-items: center; gap: 12rpx; }
.mt-dot { width: 28rpx; height: 0; border-top: 4rpx dashed #7c6cf0; }

/* 清单聚焦态 */
.place-item.focused { background: #efecff; box-shadow: inset 6rpx 0 0 #6f5ce8; }
