.login {
    position: relative;
    overflow: hidden;
    padding: 44rpx 36rpx 34rpx;
    background: #ffffff;
    border-radius: 30rpx;
    box-shadow: 0 20rpx 60rpx rgba(42, 30, 90, 0.12), 0 2rpx 8rpx rgba(42, 30, 90, 0.04);
}
/* 顶部品牌光带 */
.login::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 6rpx;
    background: linear-gradient(90deg, #7c6cf0, #a56bf0, #ff9f68);
}

.login-badge {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 72rpx;
    height: 72rpx;
    border-radius: 22rpx;
    background: linear-gradient(135deg, #7c6cf0, #5a49c4);
    color: #ffd166;
    font-size: 40rpx;
    box-shadow: 0 8rpx 20rpx rgba(111, 92, 232, 0.32);
}

.login-eyebrow {
    display: block;
    margin-top: 26rpx;
    font-size: 20rpx;
    font-weight: 700;
    letter-spacing: 3rpx;
    color: #8d7de8;
}

.login-title {
    display: block;
    margin-top: 8rpx;
    font-size: 40rpx;
    font-weight: 800;
    color: #17152b;
    letter-spacing: 1rpx;
}

.login-desc {
    display: block;
    margin-top: 12rpx;
    margin-bottom: 8rpx;
    font-size: 24rpx;
    line-height: 1.6;
    color: #9a95b0;
}

.login-field {
    display: flex;
    align-items: center;
    height: 88rpx;
    padding: 0 22rpx;
    margin-top: 22rpx;
    background: #f5f4fb;
    border: 2rpx solid transparent;
    border-radius: 18rpx;
    transition: border-color 0.2s, background 0.2s;
}
.login-field:focus-within {
    border-color: #a99cf2;
    background: #fbfaff;
}

.lf-icon {
    flex-shrink: 0;
    width: 44rpx;
    font-size: 30rpx;
    color: #8d7de8;
    text-align: center;
}

.login-input {
    flex: 1;
    min-width: 0;
    height: 88rpx;
    font-size: 28rpx;
    color: #17152b;
}

.login-placeholder {
    color: #b3aec6;
}

.login-row {
    display: flex;
    align-items: center;
}

.login-field-code {
    flex: 1;
    margin-right: 16rpx;
}

.login-send {
    flex-shrink: 0;
    height: 88rpx;
    line-height: 88rpx;
    padding: 0 22rpx;
    margin-top: 22rpx;
    font-size: 24rpx;
    font-weight: 600;
    color: #6f5ce8;
    background: #ece9fb;
    border-radius: 18rpx;
    text-align: center;
}
.login-send-disabled {
    color: #a09ab8;
    background: #f2f1f7;
}

.login-button {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12rpx;
    margin-top: 30rpx;
    height: 92rpx;
    line-height: 92rpx;
    font-size: 30rpx;
    font-weight: 700;
    letter-spacing: 2rpx;
    color: #ffffff;
    background: linear-gradient(100deg, #6f5ce8 0%, #8a5ce0 55%, #a56bf0 100%);
    border-radius: 20rpx;
    box-shadow: 0 12rpx 28rpx rgba(111, 92, 232, 0.34);
}
.login-button::after {
    border: none;
}
.login-button.is-submitting {
    box-shadow: none;
}
.login-arrow {
    font-size: 34rpx;
    line-height: 1;
    font-weight: 400;
}

.login-notice {
    display: flex;
    align-items: flex-start;
    gap: 12rpx;
    margin-top: 20rpx;
    padding: 18rpx 20rpx;
    border-radius: 16rpx;
    font-size: 23rpx;
    line-height: 1.5;
}
.notice-tip {
    color: #0f8a5f;
    background: #e8f8f1;
}
.notice-error {
    color: #c14a2b;
    background: #fdf0ec;
}
.ln-icon {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32rpx;
    height: 32rpx;
    border-radius: 50%;
    font-size: 20rpx;
    font-weight: 700;
    color: #fff;
}
.notice-tip .ln-icon { background: #17a673; }
.notice-error .ln-icon { background: #e0603b; }
.ln-text { flex: 1; }

.login-agree {
    margin-top: 26rpx;
    text-align: center;
    font-size: 21rpx;
    color: #b0aac4;
}
.la-link {
    color: #8d7de8;
}
